// content.js - Boss直聘自动拓客插件核心逻辑
// 注入到 zhipin.com 页面中运行

(function() {
  'use strict';

  // 防止扩展重载后内容脚本重复注入
  if (window.__bossAutoReplyLoaded) {
    console.log('[Boss拓客] 内容脚本已加载，跳过重复注入');
    return;
  }
  window.__bossAutoReplyLoaded = true;

  // 只让顶层 frame 运行，避免 Boss 页面中 iframe 导致重复注入/重复日志
  if (window.self !== window.top) {
    return;
  }

  const PLUGIN_VERSION = '1.4.8';

  // ===== 反自动化检测补丁（极简版：只抹除 webdriver，避免重写 WebSocket 导致页面异常）=====
  (function patchAntiAutomation() {
    try {
      if (navigator.webdriver !== undefined) {
        Object.defineProperty(navigator, 'webdriver', {
          get: () => undefined,
          configurable: true,
        });
      }
    } catch (e) {
      console.warn('[Boss拓客] 反自动化补丁安装失败:', e);
    }
  })();

  // ===== 共享配置 =====
  const DEFAULT_CONFIG = {
    jobKeywords: "电商运营,天猫运营,抖音运营,小红书运营,电商总监,电商经理,电商主管,内容电商,货架电商,品牌运营",
    city: "杭州",
    dailyLimit: 100,
    intervalMin: 30,
    intervalMax: 90,
    salaryMin: 20,
    salaryMax: 50,
    workHoursOnly: true,
    greeting: "您好，看到贵司在招【岗位名】，想了解一下这个岗位目前主要解决哪类问题？我之前做过一些流程自动化相关的工作，不确定是否匹配。",
    llmEnabled: false,
    llmApiKey: "",
    llmApiType: "auto",
    llmBaseUrl: "https://api.moonshot.cn/v1",
    llmModel: "moonshot-v1-8k",
    llmThreshold: 70,
    llmJudgeSalary: false,
    llmPrompt: `你是一位严格的招聘筛选专家。请根据以下岗位信息，判断该岗位与候选人的匹配程度，并给出 0-100 的整数评分。

候选人期望：
- 目标城市：{targetCity}
- 期望薪资范围：{salaryMin}-{salaryMax}K
- 岗位方向：{keywords}
- 偏好层级：总监/经理/主管级别优先

岗位信息：
岗位名称：{title}
薪资：{salary}
城市：{city}
公司：{company}
岗位描述：{description}

评分规则（请严格执行）：
- 薪资低于 {salaryMin}K 或高于 {salaryMax}K：0-30 分
- 城市不是 {targetCity}：0-30 分
- 岗位方向与 {keywords} 明显不符：0-30 分
- 岗位层级过低（如专员/助理/实习生）且没有管理属性：20-40 分
- 薪资、城市、方向均匹配且层级合适：70-100 分

请严格返回 JSON 格式，不要输出任何其他内容：
{
  "score": 0-100的整数,
  "reason": "简要说明匹配或不匹配的理由"
}`,
  };
  const STORAGE_KEY = "bossAutoReplyConfig";
  const STATE_KEY = "bossAutoReplyState";
  const LOG_KEY = "bossAutoReplyLogs";
  const SENT_KEY = "bossAutoReplySent";

  // Boss 直聘城市 code 映射（用于标签无 href 时直接构造搜索 URL）
  const CITY_CODE_MAP = {
    '北京': '101010100',
    '上海': '101020100',
    '广州': '101280100',
    '深圳': '101280600',
    '杭州': '101210100',
    '成都': '101270100',
    '武汉': '101200100',
    '南京': '101190100',
    '西安': '101110100',
    '重庆': '101040100',
    '苏州': '101190400',
    '天津': '101030100',
  };

  // 标记 content script 已注入，供 popup 诊断使用
  try { window.__BOSS_AUTO_REPLY_INJECTED__ = true; } catch (e) {}

  // ===== 状态 =====
  let isRunning = false;
  let shouldStop = false;
  let isStarting = false; // 启动锁，防止 autoResume 与手动启动冲突
  let config = {};
  let stats = { total: 0, success: 0, skipped: 0, failed: 0 };
  const MAX_LOGS = 500;
  const SENT_TTL_DAYS = 30;
  const MAX_RETRIES = 2;

  // 防止同一岗位并发/重试时重复发送
  const _inFlightSends = new Set();
  function markInFlight(jobId) { if (jobId) _inFlightSends.add(jobId); }
  function clearInFlight(jobId) { if (jobId) _inFlightSends.delete(jobId); }
  function isInFlight(jobId) { return !!jobId && _inFlightSends.has(jobId); }

  // 当前会话内是否已应用过官方薪资筛选（避免 SPA 内重复点击筛选器）
  let salaryFilterAppliedInSession = false;

  // ===== 工具函数 =====

  function sleep(ms) {
    return new Promise(r => setTimeout(r, ms));
  }

  function randomBetween(min, max) {
    return Math.random() * (max - min) + min;
  }

  // 带重试执行异步函数
  async function withRetry(fn, retries = MAX_RETRIES, label = "操作") {
    let lastErr = null;
    for (let i = 0; i <= retries; i++) {
      try {
        return await fn();
      } catch (e) {
        lastErr = e;
        if (i < retries) {
          log(`[重试] ${label} 第 ${i + 1} 次失败: ${e.message}，稍后重试`);
          await sleep(randomBetween(800, 1500));
        }
      }
    }
    throw lastErr || new Error(`${label} 失败`);
  }

  // 移除零宽字符和控制字符（保留换行、回车、制表符）
  function stripInvisibleChars(text) {
    if (!text) return "";
    const zeroWidth = new RegExp("[\u200B-\u200F\u2028-\u202E\u2060-\u2069\uFEFF]", "g");
    const controls = new RegExp("[\x00-\x08\x0B\x0C\x0E-\x1F\x7F-\x9F]", "g");
    return text.replace(zeroWidth, "").replace(controls, "");
  }

  // 解析薪资 "30-55K" / "30—55千" / "20.5K" / PUA字体替换 -> [30, 55]
  function parseSalary(text) {
    if (!text) return [0, 0];
    let normalized = stripInvisibleChars(text)
      .replace(/[０-９]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0))
      .replace(/[Ａ-Ｚａ-ｚ]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0))
      .replace(/－/g, '-');
    const m = normalized.match(/(\d+(?:\.\d+)?)\s*[-~–—]\s*(\d+(?:\.\d+)?)\s*[Kk千]/);
    if (m) return [parseFloat(m[1]), parseFloat(m[2])];
    const m3 = normalized.match(/(\d+(?:\.\d+)?)\s*[Kk千]\s*[-~–—]\s*(\d+(?:\.\d+)?)\s*[Kk千]/);
    if (m3) return [parseFloat(m3[1]), parseFloat(m3[2])];
    const m2 = normalized.match(/(\d+(?:\.\d+)?)\s*[Kk千]/);
    if (m2) return [parseFloat(m2[1]), parseFloat(m2[1])];
    return decodePUASalary(normalized);
  }

  // 解码Boss直聘PUA字体替换的薪资（如-K -> 12-18K）
  function decodePUASalary(text) {
    const PUA_BASE = 0xE031;
    const puaToNum = (ch) => {
      const n = ch.charCodeAt(0) - PUA_BASE;
      return (n >= 0 && n <= 9) ? n : -1;
    };
    const decodeChars = (chars) => {
      let val = 0;
      for (const ch of chars) {
        const n = puaToNum(ch);
        if (n < 0) return -1;
        val = val * 10 + n;
      }
      return val;
    };
    const rangePattern = /([-]+)\s*[-~–—]\s*([-]+)\s*[Kk千]/;
    const rm = text.match(rangePattern);
    if (rm) {
      const min = decodeChars(rm[1]);
      const max = decodeChars(rm[2]);
      if (min >= 0 && max >= 0 && min < 1000 && max < 1000) return [min, max];
    }
    const singlePattern = /([-]+)\s*[Kk千]/;
    const sm = text.match(singlePattern);
    if (sm) {
      const val = decodeChars(sm[1]);
      if (val >= 0 && val < 1000) return [val, val];
    }
    return [0, 0];
  }

  // ===== 日志系统 =====
  const _logs = [];

  async function initLogs() {
    try {
      const result = await chrome.storage.local.get(LOG_KEY);
      const saved = result[LOG_KEY];
      if (Array.isArray(saved)) {
        _logs.push(...saved);
        while (_logs.length > MAX_LOGS) _logs.shift();
      }
    } catch (e) {}
  }

  async function persistLogs() {
    try {
      await chrome.storage.local.set({ [LOG_KEY]: _logs.slice(-MAX_LOGS) });
    } catch (e) {}
  }

  function log(msg) {
    const line = `[Boss拓客] ${msg}`;
    console.log(line);
    const entry = { time: new Date().toLocaleTimeString(), msg };
    _logs.push(entry);
    if (_logs.length > MAX_LOGS) _logs.shift();
    persistLogs();
    try {
      chrome.runtime.sendMessage({ action: "logs", logs: getLogs(100) });
    } catch (e) {}
  }

  function getLogs(limit = 100) {
    return _logs.slice(-limit);
  }

  function sendStatus(text, type = "idle") {
    try {
      chrome.runtime.sendMessage({ action: "status", text, type });
    } catch (e) {}
  }

  function sendStats() {
    try {
      chrome.runtime.sendMessage({ action: "stats", stats: { ...stats } });
    } catch (e) {}
  }

  log(`[系统] Boss拓客 v${PLUGIN_VERSION} 内容脚本已加载，页面: ${location.href}`);

  // 保存/恢复运行状态
  function saveState(state) {
    try {
      sessionStorage.setItem(STATE_KEY, JSON.stringify(state));
    } catch (e) {}
  }

  function loadState() {
    try {
      const saved = sessionStorage.getItem(STATE_KEY);
      return saved ? JSON.parse(saved) : null;
    } catch (e) {
      return null;
    }
  }

  function clearState() {
    try {
      sessionStorage.removeItem(STATE_KEY);
    } catch (e) {}
  }

  // 加载配置
  async function loadConfig() {
    try {
      const result = await chrome.storage.local.get(STORAGE_KEY);
      config = { ...DEFAULT_CONFIG, ...(result[STORAGE_KEY] || {}) };
    } catch (e) {
      config = { ...DEFAULT_CONFIG };
    }
  }

  // ===== DOM 工具 =====

  function isNegativeAction(text) {
    if (!text) return false;
    return /不感兴趣|举报|屏蔽|删除|收藏|分享|关注|取消|拒绝|跳过/.test(text);
  }

  function isVisible(el) {
    if (!el) return false;
    const rect = el.getBoundingClientRect();
    return el.offsetParent !== null && rect.width >= 20 && rect.height >= 20;
  }

  // 坐标模拟鼠标点击（绕过 React/Vue 框架事件限制）
  async function simulateClick(el) {
    if (!el) return false;

    // 第一次滚动并记录位置
    el.scrollIntoView({ behavior: 'instant', block: 'center' });
    await sleep(300);

    // 确认元素仍在 DOM 中且位置稳定（防止虚拟滚动回收元素）
    if (!document.contains(el)) {
      log("[点击失败] 元素已被回收");
      return false;
    }
    const rect1 = el.getBoundingClientRect();
    await sleep(200);
    const rect2 = el.getBoundingClientRect();
    if (Math.abs(rect1.left - rect2.left) > 10 || Math.abs(rect1.top - rect2.top) > 10) {
      log("[点击失败] 元素位置不稳定");
      return false;
    }

    const cx = rect2.left + rect2.width / 2;
    const cy = rect2.top + rect2.height / 2;
    const events = [
      { type: 'mousemove', opts: { bubbles: true, cancelable: true, clientX: cx, clientY: cy } },
      { type: 'mousedown', opts: { bubbles: true, cancelable: true, clientX: cx, clientY: cy, button: 0 } },
      { type: 'mouseup',   opts: { bubbles: true, cancelable: true, clientX: cx, clientY: cy, button: 0 } },
      { type: 'click',     opts: { bubbles: true, cancelable: true, clientX: cx, clientY: cy, button: 0 } },
    ];
    for (const ev of events) {
      el.dispatchEvent(new MouseEvent(ev.type, ev.opts));
      await sleep(randomBetween(30, 80));
    }
    return true;
  }

  // React 兼容的输入框设值
  function setReactInputValue(input, value) {
    const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
    if (nativeSetter) {
      nativeSetter.call(input, value);
    } else {
      input.value = value;
    }
    input.dispatchEvent(new Event('input', { bubbles: true }));
    input.dispatchEvent(new Event('change', { bubbles: true }));
  }

  // React 兼容的 textarea 设值
  function setReactTextareaValue(textarea, value) {
    const nativeTextareaSetter = Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype, 'value').set;
    const nativeInputSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
    if (nativeTextareaSetter) {
      nativeTextareaSetter.call(textarea, value);
    } else if (nativeInputSetter) {
      nativeInputSetter.call(textarea, value);
    } else {
      textarea.value = value;
    }
    textarea.dispatchEvent(new Event('input', { bubbles: true }));
    textarea.dispatchEvent(new Event('change', { bubbles: true }));
  }

  // contenteditable 输入框填充：优先 execCommand，失败后回退 innerText
  function setContenteditableValue(el, text) {
    if (!el || !el.isContentEditable) return false;

    el.focus();
    el.click();

    // 策略 1：execCommand selectAll + insertText（对大多数 React contenteditable 有效）
    try {
      el.innerHTML = '';
      if (document.queryCommandSupported && document.queryCommandSupported('insertText')) {
        document.execCommand('selectAll', false, null);
        document.execCommand('insertText', false, text);
      } else {
        el.innerText = text;
      }
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
      el.dispatchEvent(new CompositionEvent('compositionend', { bubbles: true, data: text }));
      el.dispatchEvent(new KeyboardEvent('keydown', { key: 'End', code: 'End', keyCode: 35, which: 35, bubbles: true }));
      el.dispatchEvent(new KeyboardEvent('keyup', { key: 'End', code: 'End', keyCode: 35, which: 35, bubbles: true }));
      return true;
    } catch (e) {
      log(`[输入] execCommand 异常: ${e.message}`);
    }

    // 策略 2：直接 innerText
    try {
      el.innerHTML = '';
      el.innerText = text;
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
      el.dispatchEvent(new CompositionEvent('compositionend', { bubbles: true, data: text }));
      el.dispatchEvent(new KeyboardEvent('keydown', { key: 'End', code: 'End', keyCode: 35, which: 35, bubbles: true }));
      el.dispatchEvent(new KeyboardEvent('keyup', { key: 'End', code: 'End', keyCode: 35, which: 35, bubbles: true }));
      return true;
    } catch (e) {
      log(`[输入] innerText 异常: ${e.message}`);
    }

    return false;
  }

  function getInputText(el) {
    if (!el) return '';
    if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
      return (el.value || '').trim();
    }
    return (el.innerText || el.textContent || '').trim();
  }

  async function fillChatInput(input, text) {
    log(`[输入] 开始填充，长度=${text.length}, 类型=${input.tagName}, contenteditable=${input.isContentEditable}`);

    if (input.tagName === 'TEXTAREA') {
      setReactTextareaValue(input, text);
      await sleep(200);
      const filled = getInputText(input);
      log(`[输入] TEXTAREA 填充后长度=${filled.length}`);
      return filled.length >= text.trim().length * 0.5;
    }
    if (input.tagName === 'INPUT') {
      setReactInputValue(input, text);
      await sleep(200);
      const filled = getInputText(input);
      log(`[输入] INPUT 填充后长度=${filled.length}`);
      return filled.length >= text.trim().length * 0.5;
    }
    if (input.isContentEditable) {
      setContenteditableValue(input, text);
      await sleep(300);
      const filled = getInputText(input);
      log(`[输入] contenteditable 填充后长度=${filled.length}`);
      return filled.length >= text.trim().length * 0.5;
    }

    return false;
  }

  // ===== 职位页逻辑 =====

  function isJobListPage() {
    // 放宽匹配：首页、城市页、职位列表页、搜索页等
    const href = location.href;
    return /zhipin\.com\/(?:$|beijing\/|shanghai\/|guangzhou\/|shenzhen\/|hangzhou\/|chengdu\/|web\/geek\/job|web\/geek\/jobs|job\/|search\/)/.test(href);
  }

  function isChatPage() {
    return /\/web\/geek\/chat/.test(location.href);
  }

  function isJobCardLike(el) {
    if (!el || !isVisible(el)) return false;
    const rect = el.getBoundingClientRect();
    // 合理的卡片尺寸
    if (rect.width < 150 || rect.width > 900 || rect.height < 50 || rect.height > 500) return false;

    const text = (el.innerText || "").trim();
    if (text.length < 15) return false;

    // 必须包含有效薪资
    const [sMin, sMax] = parseSalary(text);
    if (sMin <= 0 || sMax <= 0) return false;

    // 必须包含岗位相关词（避免把公司块、广告位当作卡片）
    if (!/(运营|经理|总监|主管|专员|助理|顾问|秘书|工程师|设计师|编辑|主播|客服|销售|采购|供应链|商务|推广|策划|品牌|市场|产品|开发|测试|数据|分析|内容)/.test(text)) {
      return false;
    }

    return true;
  }

  function getJobCards() {
    // 策略1：精确选择器
    const selectors = [
      '.job-list-wrapper .job-card-wrapper',
      '.search-job-result .job-card-wrapper',
      '.job-list-box > div',
      '.job-list-box > li',
      '[class*="job-list"] [class*="job-card"]',
      '[class*="search-job"] [class*="card"]',
      '.job-card-wrapper',
      '[class*="job-card"]',
    ];

    for (const sel of selectors) {
      let cards;
      try {
        cards = document.querySelectorAll(sel);
      } catch (e) { continue; }
      if (cards.length === 0) continue;

      const validCards = [];
      for (const card of cards) {
        if (isJobCardLike(card)) {
          validCards.push(card);
        }
      }

      if (validCards.length > 0) {
        log(`[卡片] 使用选择器 ${sel} 找到 ${validCards.length} 个有效卡片`);
        // 限制最大数量，避免虚拟滚动列表中元素过多
        return validCards.slice(0, 30);
      }
    }

    // 策略2：基于"立即沟通/继续沟通"按钮反查卡片
    const chatBtns = document.querySelectorAll('button, a');
    const cardSet = new Set();
    for (const btn of chatBtns) {
      const t = (btn.innerText || btn.textContent || '').trim();
      if (!/(立即沟通|继续沟通)/.test(t)) continue;
      let ancestor = btn.parentElement;
      for (let depth = 0; depth < 8 && ancestor; depth++) {
        if (isJobCardLike(ancestor)) {
          cardSet.add(ancestor);
          break;
        }
        ancestor = ancestor.parentElement;
      }
    }
    if (cardSet.size > 0) {
      const cards = Array.from(cardSet);
      log(`[卡片] 通过沟通按钮反查找到 ${cards.length} 个有效卡片`);
      return cards.slice(0, 30);
    }

    log('[卡片] 所有选择器均未找到有效职位卡片');
    return [];
  }

  function extractCardInfo(card) {
    const rawText = card.innerText || "";
    const text = stripInvisibleChars(rawText);
    const lines = text.split('\n').map(l => l.trim()).filter(Boolean);

    let title = "";
    let salary = "";
    let salaryLineIndex = -1;
    let company = "未知公司";
    let city = "";
    let jobId = "";

    // 找薪资行（统一走 parseSalary，支持普通数字和 PUA 字体）
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      const [sMin, sMax] = parseSalary(line);
      if (sMin > 0 && sMax > 0) {
        salary = `${sMin}-${sMax}K`;
        salaryLineIndex = i;
        // 尝试从薪资行前面提取岗位名
        const m = line.match(/(\d+(?:\.\d+)?)\s*[-~–—]\s*(\d+(?:\.\d+)?)\s*[Kk千·]/);
        const m2 = line.match(/(\d+(?:\.\d+)?)\s*[Kk千·]/);
        const match = m || m2;
        if (match) {
          const beforeSalary = line.substring(0, match.index).trim();
          if (beforeSalary && beforeSalary.length > 2) title = beforeSalary;
        }
        break;
      }
    }

    // 推断岗位名
    if (!title) {
      const candidates = [];
      if (salaryLineIndex > 0) candidates.push(lines[salaryLineIndex - 1]);
      if (salaryLineIndex === 0 && lines.length > 1) candidates.push(lines[1]);
      if (candidates.length === 0) candidates.push(...lines);

      let bestScore = -999;
      let bestTitle = "";
      for (const candidate of candidates) {
        if (!candidate || candidate.length < 2 || candidate.length > 40) continue;
        if (/^[一-龥]{2,4}[市省]?[·\s][一-龥]+(?:区|县|市|镇|街道)/.test(candidate)) continue;
        let score = 0;
        if (/助理|秘书|经理|总监|主管|专员|顾问/.test(candidate)) score += 10;
        if (candidate.length >= 4 && candidate.length <= 20) score += 5;
        if (/科技|有限|公司|网络|传媒|集团|股份|文化/.test(candidate)) score -= 20;
        if (score > bestScore) {
          bestScore = score;
          bestTitle = candidate;
        }
      }
      title = bestScore > 0 ? bestTitle : "";
    }

    // 提取公司名
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      if (/科技|有限|公司|网络|传媒|文化|商贸|电子商务|集团|股份|咨询|管理|建材|餐饮|教育|医疗|美容|酒店|旅游|物流|贸易|实业|工作室/.test(line) && line.length >= 4 && line.length <= 35) {
        company = line;
        break;
      }
    }
    // 若未匹配到，尝试选最长且不像岗位/薪资/地点的行
    if (company === '未知公司') {
      let bestCompany = '';
      for (const line of lines) {
        if (line.length < 4 || line.length > 35) continue;
        if (/\d+\s*[Kk千·]|经验|学历|本科|大专|不限|应届|在校生|应届|杭州|北京|上海|广州|深圳|成都|武汉|西安|南京/.test(line)) continue;
        if (line === title) continue;
        if (line.length > bestCompany.length) bestCompany = line;
      }
      if (bestCompany) company = bestCompany;
    }

    // 提取城市
    const cityPattern = /([一-龥]{2,4}[市省]?)[·\s]([一-龥]+(?:区|县|市|镇|街道))/;
    const m1 = text.match(cityPattern);
    if (m1) {
      city = m1[1];
    } else {
      const targetCity = (config.city || '').trim();
      if (targetCity && text.includes(targetCity)) city = targetCity;
    }

    // 提取 jobId：优先从链接提取，稳定唯一
    let link = card.querySelector('a[href*="/job_detail/"]') || card.querySelector('a[href*="/job/"]');
    if (link) {
      const href = link.getAttribute("href") || "";
      const m = href.match(/\/job_detail\/(\w+)\.html/) || href.match(/\/job\/(\w+)/);
      if (m) jobId = m[1];
    }
    if (!jobId && title) {
      // 岗位+薪资+城市 组合比公司名更稳定，避免公司名提取失败导致全部重复
      const salaryKey = salary || '0';
      jobId = `${title}_${salaryKey}_${city}_${company}`.replace(/\s+/g, '_').slice(0, 120);
    }
    if (!jobId) {
      jobId = `${company}-${title}-${salary}`.replace(/\s+/g, '_');
    }

    return { title, salary, company, city, jobId };
  }

  function isTargetJob(info) {
    if (!info.title) return false;
    const keywords = (config.jobKeywords || "").split(/[,，]/).map(k => k.trim()).filter(Boolean);
    if (keywords.length === 0) return true;
    const titleLower = info.title.toLowerCase();
    const match = keywords.some(k => titleLower.includes(k.toLowerCase()));
    if (!match) {
      log(`[过滤] 岗位不匹配: "${info.title}"`);
      return false;
    }

    const targetCity = (config.city || "").trim();
    if (targetCity && info.city && !info.city.includes(targetCity) && !targetCity.includes(info.city)) {
      log(`[过滤] 城市不匹配: "${info.city}" 不是 "${targetCity}"`);
      return false;
    }

    const [sMin, sMax] = parseSalary(info.salary);
    let cfgMin = Number(config.salaryMin);
    let cfgMax = Number(config.salaryMax);
    // 兼容旧配置：上限超过 50K 时按 50K 过滤，避免低价岗位漏进来
    if (cfgMax > 50) {
      log(`[调试-薪资] 配置上限 ${cfgMax}K 超过 50K，按 50K 过滤`);
      cfgMax = 50;
    }
    log(`[调试-薪资] 岗位="${info.title}", 原始薪资="${info.salary}", 解析=[${sMin},${sMax}], 配置=[${cfgMin},${cfgMax}]`);

    // 如果启用大模型且选择让大模型判断薪资，跳过硬过滤薪资，交给 LLM
    if (config.llmEnabled && config.llmApiKey && config.llmJudgeSalary) {
      log(`[薪资] 交给 LLM 判断: "${info.salary}"`);
    } else if (sMin > 0 && sMax > 0) {
      if (cfgMin > 0 && sMax < cfgMin) {
        log(`[过滤] 薪资过低: "${info.salary}" 上限 ${sMax}K 低于最低要求 ${cfgMin}K`);
        return false;
      }
      if (cfgMax > 0 && sMin > cfgMax) {
        log(`[过滤] 薪资过高: "${info.salary}" 下限 ${sMin}K 高于最高要求 ${cfgMax}K`);
        return false;
      }
    }

    return true;
  }

  function findChatBtn(container = document) {
    const allBtns = container.querySelectorAll('button, a, [class*="btn"]');

    for (const btn of allBtns) {
      if (!isVisible(btn)) continue;
      const text = (btn.innerText || btn.textContent || "").trim();
      if (text.includes("立即沟通") && !isNegativeAction(text)) return btn;
    }

    for (const btn of allBtns) {
      if (!isVisible(btn)) continue;
      const text = (btn.innerText || btn.textContent || "").trim();
      if (text.includes("继续沟通") && !isNegativeAction(text)) return btn;
    }

    // 兜底：只匹配明确的正向操作，且排除负面/无关按钮
    for (const btn of allBtns) {
      if (!isVisible(btn)) continue;
      const text = (btn.innerText || btn.textContent || "").trim();
      if (!text) continue;
      if (isNegativeAction(text)) continue;
      // 部分包含匹配，更宽松
      if (text.includes("立即沟通") || text.includes("继续沟通") || text.includes("投递简历") || text.includes("发消息") || text.includes("聊一聊") || text.includes("打招呼")) return btn;
      // 检查 aria-label / title
      const ariaLabel = (btn.getAttribute("aria-label") || "").trim();
      const title = (btn.getAttribute("title") || "").trim();
      if (ariaLabel.includes("立即沟通") || ariaLabel.includes("继续沟通") || ariaLabel.includes("投递简历") || ariaLabel.includes("发消息") || ariaLabel.includes("聊一聊") || ariaLabel.includes("打招呼")) return btn;
      if (title.includes("立即沟通") || title.includes("继续沟通") || title.includes("投递简历") || title.includes("发消息") || title.includes("聊一聊") || title.includes("打招呼")) return btn;
    }

    // 调试：输出候选按钮信息
    const candidates = Array.from(allBtns).filter(b => isVisible(b)).filter(b => {
      const t = (b.innerText || b.textContent || '').trim();
      return /沟通|联系|投递|发消息|聊一聊|打招呼/.test(t);
    });
    if (candidates.length > 0) {
      log(`[调试] 找到 ${candidates.length} 个沟通相关候选按钮：` + candidates.slice(0, 3).map(b => `"${(b.innerText || '').trim().slice(0, 12)}"(${b.tagName})`).join(', '));
    }

    return null;
  }

  // ===== 聊天页逻辑 =====

  function findChatContainer() {
    const selectors = [
      '.chat-container',
      '.chat-main',
      '.chat-box',
      '.message-panel',
      '[class*="chat-panel"]',
      '[class*="chat-main"]',
      '[class*="message-panel"]',
      '[class*="im-chat"]',
    ];
    for (const sel of selectors) {
      const el = document.querySelector(sel);
      if (el && isVisible(el)) return el;
    }
    return null;
  }

  async function waitForChatInput(timeoutMs = 5000) {
    function isLikelyChatInput(el) {
      if (!el || !isVisible(el)) return false;
      const rect = el.getBoundingClientRect();
      const placeholder = (el.getAttribute('placeholder') || '').trim();
      const ariaLabel = (el.getAttribute('aria-label') || '').trim();
      const cls = (el.className || '').toString().toLowerCase();
      const parentText = (el.parentElement?.innerText || el.parentElement?.textContent || '').slice(0, 100).toLowerCase();
      const ancestorText = (el.closest('div, section, aside, nav')?.innerText || '').slice(0, 200).toLowerCase();

      // 排除顶部联系人搜索框
      if (/搜索/.test(placeholder) || /搜索/.test(ariaLabel)) return false;
      if (/搜索.*联系|搜索.*30天/.test(ancestorText)) return false;
      if (cls.includes('search')) return false;
      // 排除明显在顶部区域的小输入框
      if (rect.bottom < window.innerHeight * 0.5) return false;
      return true;
    }

    const selectors = [
      '.chat-editor[contenteditable="true"]',
      '.message-editor[contenteditable="true"]',
      '.editor[contenteditable="true"]',
      '[class*="chat-editor"][contenteditable="true"]',
      '[class*="message-editor"][contenteditable="true"]',
      '[class*="editor"][contenteditable="true"]',
      '[contenteditable="true"]',
      '.chat-editor',
      '.message-editor',
      '.editor',
      '.input',
      'textarea',
      'input[type="text"]',
    ];
    const start = Date.now();
    while (Date.now() - start < timeoutMs) {
      const container = findChatContainer();
      const scope = container || document;
      for (const sel of selectors) {
        const el = scope.querySelector(sel);
        if (el && isLikelyChatInput(el)) {
          const rect = el.getBoundingClientRect();
          log(`[输入框] 选择器匹配: "${sel}", tag=${el.tagName}, class=${(el.className||'').toString().slice(0,60)}, bottom=${Math.round(rect.bottom)}`);
          return el;
        }
      }
      const allEditable = document.querySelectorAll('[contenteditable="true"]');
      let bestCandidate = null;
      let bestScore = -1;
      for (const el of allEditable) {
        if (!isLikelyChatInput(el)) continue;
        const rect = el.getBoundingClientRect();
        const parentText = (el.parentElement?.innerText || '').slice(0, 200).toLowerCase();
        let score = 0;
        if (rect.bottom > window.innerHeight * 0.6) score += 10;
        if (rect.bottom > window.innerHeight * 0.8) score += 5;
        if (/chat|message|editor|input|send/.test(parentText)) score += 20;
        if (!el.closest('[class*="job-card"]') && !el.closest('[class*="job-list"]')) score += 10;
        if (rect.width > 100 && rect.height > 20) score += 5;
        if (score > bestScore) {
          bestScore = score;
          bestCandidate = el;
        }
      }
      if (bestCandidate) {
        log(`[输入框] 启发式匹配: tag=${bestCandidate.tagName}, class=${(bestCandidate.className||'').toString().slice(0,60)}, score=${bestScore}`);
        return bestCandidate;
      }
      await sleep(300);
    }
    log('[输入框] 超时: 未找到聊天输入框');
    return null;
  }

  function isSendButton(el) {
    if (!el || !isVisible(el)) return false;
    const t = (el.innerText || el.textContent || '').trim();
    const aria = (el.getAttribute('aria-label') || '').trim();
    const title = (el.getAttribute('title') || '').trim();
    const cls = (el.className || '').toString().toLowerCase();

    // 文本匹配
    if (/发送|Send|submit|post/i.test(t) || /发送|Send|submit|post/i.test(aria) || /发送|Send|submit|post/i.test(title)) {
      return true;
    }

    // 类名匹配
    if (/send|submit|post|btn-primary/.test(cls)) {
      return true;
    }

    // 图标按钮兜底：绿色、底部、可点击
    const rect = el.getBoundingClientRect();
    const style = window.getComputedStyle(el);
    const bgColor = style.backgroundColor || '';
    const isGreen = /rgb\(\s*(0|1|2|3|4|5|6|7)\s*,\s*(1[5-9][0-9]|2[0-5][0-9])\s*,\s*(0|1|2|3|4|5|6|7)\s*\)/.test(bgColor) ||
                    /#0[0-9a-f][0-9a-f][0-9a-f]/.test(style.backgroundColor) ||
                    bgColor.includes('green');
    const isNearBottom = rect.top > window.innerHeight * 0.75;
    const isButtonLike = el.tagName === 'BUTTON' || el.getAttribute('role') === 'button' ||
                         style.cursor === 'pointer' || cls.includes('btn');

    if (isGreen && isNearBottom && isButtonLike) {
      return true;
    }

    return false;
  }

  function scoreSendButtonLikelihood(el, inputEl) {
    let score = 0;
    const rect = el.getBoundingClientRect();
    const style = window.getComputedStyle(el);
    const cls = (el.className || '').toString().toLowerCase();
    const bgColor = style.backgroundColor || '';

    // 绿色背景（Boss 发送按钮常见绿色）
    if (/rgb\(\s*0\s*,\s*(1[5-9][0-9]|2[0-5][0-9])\s*,\s*(0|1|2|3|4|5|6|7)\s*\)/.test(bgColor)) score += 5;
    if (/green|primary|send|submit/.test(cls)) score += 4;

    // 底部位置
    if (rect.top > window.innerHeight * 0.8) score += 3;
    if (rect.top > window.innerHeight * 0.7) score += 2;

    // 按钮特征
    if (el.tagName === 'BUTTON') score += 3;
    if (el.getAttribute('role') === 'button') score += 2;
    if (style.cursor === 'pointer') score += 1;

    // 靠近输入框
    if (inputEl) {
      const inputRect = inputEl.getBoundingClientRect();
      const xDist = Math.abs((rect.left + rect.width / 2) - (inputRect.left + inputRect.width / 2));
      const yDist = Math.abs((rect.top + rect.height / 2) - (inputRect.top + inputRect.height / 2));
      if (xDist < 200 && yDist < 100) score += 3;
    }

    // 排除负面操作
    const text = (el.innerText || el.textContent || '').trim();
    if (isNegativeAction(text)) score -= 10;

    // 合理尺寸
    if (rect.width > 30 && rect.height > 20 && rect.width < 200 && rect.height < 100) score += 1;

    return score;
  }

  async function findSendButton(inputEl) {
    const debug = [];

    // 0. Boss 直聘特定选择器
    const specificSelectors = [
      '.chat-editor + button',
      '.chat-editor ~ button',
      '.message-editor + button',
      '.message-editor ~ button',
      '[class*="chat-editor"] + button',
      '[class*="chat-editor"] ~ button',
      '[class*="send"]',
      '[class*="submit"]',
      'button[type="submit"]',
    ];
    for (const sel of specificSelectors) {
      try {
        const el = document.querySelector(sel);
        if (el && isVisible(el) && isSendButton(el)) {
          log(`[发送按钮] 特定选择器匹配: "${sel}", tag=${el.tagName}, text="${(el.innerText||'').trim().slice(0,12)}"`);
          return el;
        }
      } catch (e) {}
    }

    // 1. 在聊天容器内精确查找
    const container = findChatContainer();
    let scope = container || document;
    const allClickables = scope.querySelectorAll('button, [role="button"], div, span, a');
    for (const el of allClickables) {
      if (isSendButton(el)) {
        log(`[发送按钮] 容器内精确匹配: tag=${el.tagName}, text="${(el.innerText||'').trim().slice(0,12)}", class=${(el.className||'').toString().slice(0,60)}`);
        return el;
      }
    }
    debug.push(`容器内扫描 ${allClickables.length} 个，无精确匹配`);

    // 2. 在输入框父容器中精确查找
    let p = inputEl ? inputEl.parentElement : null;
    let depth = 0;
    while (p && depth < 6) {
      const candidates = p.querySelectorAll('button, [role="button"], div, span, a');
      for (const el of candidates) {
        if (isSendButton(el)) {
          log(`[发送按钮] 父容器精确匹配(depth=${depth}): tag=${el.tagName}, text="${(el.innerText||'').trim().slice(0,12)}", class=${(el.className||'').toString().slice(0,60)}`);
          return el;
        }
      }
      debug.push(`父容器 depth=${depth} 扫描 ${candidates.length} 个，无精确匹配`);
      p = p.parentElement;
      depth++;
    }

    // 3. 全局精确查找 + 评分兜底
    const globalClickables = document.querySelectorAll('button, [role="button"], div, span, a');
    let bestCandidate = null;
    let bestScore = -1;
    for (const el of globalClickables) {
      if (!isVisible(el)) continue;
      if (isSendButton(el)) {
        log(`[发送按钮] 全局精确匹配: tag=${el.tagName}, text="${(el.innerText||'').trim().slice(0,12)}", class=${(el.className||'').toString().slice(0,60)}`);
        return el;
      }
      const score = scoreSendButtonLikelihood(el, inputEl);
      if (score > bestScore) {
        bestScore = score;
        bestCandidate = el;
      }
    }
    debug.push(`全局扫描 ${globalClickables.length} 个，无精确匹配`);

    // 4. 使用最高评分候选
    if (bestCandidate && bestScore >= 5) {
      log(`[发送按钮] 使用最高评分候选: score=${bestScore}, tag=${bestCandidate.tagName}, text="${(bestCandidate.innerText||'').trim().slice(0,12)}", class=${(bestCandidate.className||'').toString().slice(0,60)}`);
      return bestCandidate;
    }

    log('[发送按钮] 未找到发送按钮: ' + debug.join('；'));
    return null;
  }

  async function sendGreeting(jobTitle, jobId) {
    if (jobId && isInFlight(jobId)) {
      log(`[发送] 该岗位正在发送中，跳过重复: ${jobTitle}`);
      return false;
    }
    if (jobId) markInFlight(jobId);

    const greetingTemplate = config.greeting || DEFAULT_CONFIG.greeting;
    const greeting = greetingTemplate.replace(/【岗位名】/g, jobTitle || "该岗位");

    function dispatchSendHotkey(target, ctrlKey = false) {
      const opts = {
        key: 'Enter',
        code: 'Enter',
        keyCode: 13,
        which: 13,
        charCode: 0,
        ctrlKey,
        bubbles: true,
        cancelable: true,
      };
      target.dispatchEvent(new KeyboardEvent('keydown', opts));
      target.dispatchEvent(new KeyboardEvent('keypress', opts));
      target.dispatchEvent(new KeyboardEvent('keyup', opts));
      if (ctrlKey) {
        document.dispatchEvent(new KeyboardEvent('keydown', opts));
        document.dispatchEvent(new KeyboardEvent('keyup', opts));
      }
    }

    function hasDraft(inputEl) {
      const v = getInputText(inputEl);
      return v.length > 0 && v.length >= greeting.trim().length * 0.8;
    }

    try {
      return await withRetry(async () => {
        log(`[发送] 开始查找聊天输入框...`);
        const input = await waitForChatInput();
        if (!input) throw new Error("未找到聊天输入框");
        const inputRect = input.getBoundingClientRect();
        log(`[发送] 找到输入框: tag=${input.tagName}, editable=${input.isContentEditable}, class=${(input.className||'').toString().slice(0,60)}, bottom=${Math.round(inputRect.bottom)}`);

        // 安全检查：排除顶部搜索框
        if (inputRect.bottom < window.innerHeight * 0.5) {
          throw new Error("找到的元素位置在页面顶部，疑似搜索框，重试");
        }

        // 使用多策略填充输入框
        const filled = await fillChatInput(input, greeting);
        if (!filled) throw new Error("输入框填充失败");

        // 填充后校验并同步 React 状态
        await sleep(randomBetween(600, 1000));
        const preSendValue = getInputText(input);
        log(`[发送] 填充后验证: 长度=${preSendValue.length}, 期望=${greeting.trim().length}`);
        if (preSendValue.length < greeting.trim().length * 0.5) {
          throw new Error(`输入框内容验证失败: 实际长度=${preSendValue.length}, 期望=${greeting.trim().length}`);
        }

        if (document.activeElement && document.activeElement !== input) {
          input.focus();
          input.click();
        }
        input.dispatchEvent(new Event('input', { bubbles: true }));
        await sleep(randomBetween(300, 500));

        // 策略 1：按 Enter 发送（Boss 直聘聊天框提示"按Enter键发送"）
        log('[发送] 已填充内容，尝试 Enter 发送');
        dispatchSendHotkey(input, false);
        await sleep(randomBetween(1000, 1400));
        if (!hasDraft(input)) {
          log(`[已发送] 向 "${jobTitle}" 发送开场白（Enter）`);
          return true;
        }
        log('[发送] Enter 未清空输入，尝试点击发送按钮');

        // 策略 2：点击发送按钮
        const sendBtn = await findSendButton(input);
        if (sendBtn) {
          log(`[发送] 找到发送按钮: text="${(sendBtn.innerText||'').trim().slice(0,20)}", class=${(sendBtn.className||'').toString().slice(0,60)}`);
          if (sendBtn.disabled || sendBtn.getAttribute('disabled') || sendBtn.getAttribute('aria-disabled') === 'true') {
            throw new Error("发送按钮被禁用，可能触发风控");
          }

          const clicked = await simulateClick(sendBtn);
          if (!clicked) {
            log('[发送] simulateClick 失败，尝试直接 click()');
            sendBtn.click();
          }

          await sleep(randomBetween(400, 600));
          if (isVisible(sendBtn) && !sendBtn.disabled && sendBtn.getAttribute('aria-disabled') !== 'true') {
            log('[发送] 按钮仍可见，再次点击');
            sendBtn.click();
          }

          await sleep(randomBetween(1000, 1400));
          if (!hasDraft(input)) {
            log(`[已发送] 向 "${jobTitle}" 发送开场白（点击按钮）`);
            return true;
          }
        }

        // 策略 3：再试一次 Enter
        log('[发送] 按钮发送未清空，再次使用 Enter 键发送');
        dispatchSendHotkey(input, false);
        await sleep(randomBetween(1000, 1400));
        if (!hasDraft(input)) {
          log(`[已发送] 向 "${jobTitle}" 发送开场白（Enter 二次）`);
          return true;
        }

        // 策略 4：最后尝试 Ctrl+Enter（部分页面可能反过来）
        log('[发送] Enter 仍未清空，最后尝试 Ctrl+Enter');
        dispatchSendHotkey(input, true);
        await sleep(randomBetween(1200, 1600));
        if (!hasDraft(input)) {
          log(`[已发送] 向 "${jobTitle}" 发送开场白（Ctrl+Enter 兜底）`);
          return true;
        }

        // 发送后额外校验
        const chatContainer = findChatContainer();
        const containerText = chatContainer ? (chatContainer.innerText || '').slice(0, 500) : '';
        if (containerText.includes(greeting.slice(0, 30))) {
          log(`[已发送] 向 "${jobTitle}" 发送开场白（聊天记录校验成功）`);
          return true;
        }

        throw new Error("输入框内容未变化，发送可能失败（仍为草稿状态）");
      }, MAX_RETRIES, "发送消息");
    } finally {
      if (jobId) clearInFlight(jobId);
    }
  }

  async function closeChatPanel() {
    // 优先在聊天面板容器内查找关闭按钮
    const panelSelectors = [
      '[class*="chat-panel"]',
      '[class*="chat-drawer"]',
      '[class*="chat-box"]',
      '[class*="message-panel"]',
    ];
    let panel = null;
    for (const sel of panelSelectors) {
      panel = document.querySelector(sel);
      if (panel) break;
    }

    const scope = panel || document;
    const closeBtns = scope.querySelectorAll('button, i, span, div');
    for (const btn of closeBtns) {
      if (!isVisible(btn)) continue;
      const text = (btn.innerText || btn.textContent || "").trim();
      const cls = (btn.className || "").toString();
      if (/^关闭$|^收起$|^返回$/.test(text) || /\bclose\b|\bback\b/.test(cls.toLowerCase())) {
        await simulateClick(btn);
        return true;
      }
    }

    // 兜底：按 ESC 键关闭常见弹窗/面板
    document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', code: 'Escape', bubbles: true }));
    document.dispatchEvent(new KeyboardEvent('keyup', { key: 'Escape', code: 'Escape', bubbles: true }));
    return false;
  }

  async function goBackToJobList(jobListUrl) {
    const fallbackUrl = 'https://www.zhipin.com/web/geek/job';
    let targetUrl = jobListUrl || fallbackUrl;
    log(`[返回] 保存的职位页 URL: ${jobListUrl || '(空)'}`);

    // 清理 URL 中可能导致结果过少的过滤参数，只保留 query、city、area、page 等核心参数
    try {
      const url = new URL(targetUrl);
      if (!url.hostname.includes('zhipin.com')) {
        throw new Error('非 zhipin.com 域名');
      }
      const keep = ['query', 'city', 'area', 'page', 'pageSize', 'ka'];
      const keys = Array.from(url.searchParams.keys());
      for (const key of keys) {
        if (!keep.includes(key)) {
          url.searchParams.delete(key);
        }
      }
      targetUrl = url.toString();
    } catch (e) {
      log(`[返回] URL 解析失败: ${e.message}，使用默认职位页`);
      targetUrl = fallbackUrl;
    }

    // 如果已经在职位页且能找到多个卡片，无需跳转
    if (location.href.includes('/web/geek/job') && getJobCards().length > 1) {
      log('[返回] 当前已在职位页且已有多个卡片，无需跳转');
      return true;
    }

    // 优先直接跳转回职位页，避免 history.back() 在 SPA/新标签页中不可靠
    log(`[返回] 跳转到职位页: ${targetUrl}`);
    try {
      window.location.assign(targetUrl);
    } catch (e) {
      log(`[返回] assign 失败: ${e.message}，改用 location.href`);
      location.href = targetUrl;
    }

    // 兜底：如果 2.5 秒后仍停留在聊天页，再尝试跳转一次
    setTimeout(() => {
      if (isChatPage()) {
        log('[返回] 首次跳转未生效，再次尝试跳转');
        location.href = targetUrl;
      }
    }, 2500);

    return true;
  }

  // ===== 风控与去重 =====

  // 风控提示词（包括 toast/弹窗可能短暂出现的文本）
  const RISK_PATTERNS = [
    "操作频繁", "发送失败", "过于频繁", "请稍后再试",
    "系统繁忙", "休息一下", "验证", "验证码",
    "您的操作太快", "请勿频繁", "环境异常",
  ];

  function checkTextRisk(text) {
    return RISK_PATTERNS.some(p => text.includes(p));
  }

  // 启动 MutationObserver 监听动态弹窗/toast
  let riskObserver = null;
  function startRiskObserver() {
    if (riskObserver) return;
    riskObserver = new MutationObserver((mutations) => {
      for (const m of mutations) {
        if (m.type === 'childList') {
          for (const node of m.addedNodes) {
            if (node.nodeType === Node.ELEMENT_NODE) {
              const text = (node.innerText || node.textContent || "").slice(0, 200);
              if (checkTextRisk(text)) {
                log(`[风控] 检测到动态风险提示: ${text.slice(0, 60)}`);
                shouldStop = true;
              }
            }
          }
        }
      }
    });
    riskObserver.observe(document.body, { childList: true, subtree: true });
  }

  function stopRiskObserver() {
    if (riskObserver) {
      riskObserver.disconnect();
      riskObserver = null;
    }
  }

  function isRiskDetected() {
    // 1. 页面文本
    const bodyText = document.body.innerText || "";
    if (checkTextRisk(bodyText)) return true;

    // 2. 发送按钮被禁用
    const sendBtn = document.querySelector('[class*="send"], button');
    if (sendBtn) {
      const text = (sendBtn.innerText || sendBtn.textContent || "").trim();
      if (/发送/.test(text) && (sendBtn.disabled || sendBtn.getAttribute('disabled') || sendBtn.getAttribute('aria-disabled') === 'true')) {
        log("[风控] 发送按钮被禁用");
        return true;
      }
    }

    return false;
  }

  function isInWorkHours() {
    if (!config.workHoursOnly) return true;
    const hour = new Date().getHours();
    return hour >= 9 && hour < 18;
  }

  function getSentMap() {
    try {
      const saved = localStorage.getItem(SENT_KEY);
      return saved ? JSON.parse(saved) : {};
    } catch (e) {
      return {};
    }
  }

  function saveSentMap(map) {
    try {
      localStorage.setItem(SENT_KEY, JSON.stringify(map));
    } catch (e) {}
  }

  function cleanExpiredSent() {
    const map = getSentMap();
    const now = Date.now();
    const ttl = SENT_TTL_DAYS * 24 * 60 * 60 * 1000;
    let changed = false;
    for (const key of Object.keys(map)) {
      if (!map[key] || now - (map[key].time || 0) > ttl) {
        delete map[key];
        changed = true;
      }
    }
    if (changed) saveSentMap(map);
  }

  function isDuplicate(jobId) {
    const map = getSentMap();
    const record = map[jobId];
    if (!record) return false;
    const now = Date.now();
    const ttl = SENT_TTL_DAYS * 24 * 60 * 60 * 1000;
    if (now - record.time > ttl) {
      delete map[jobId];
      saveSentMap(map);
      return false;
    }
    return true;
  }

  function recordSent(jobId) {
    const map = getSentMap();
    map[jobId] = { time: Date.now() };
    saveSentMap(map);
  }

  function randomInterval() {
    const min = Math.max(5, config.intervalMin || 30);
    const max = Math.max(min + 1, config.intervalMax || 90);
    return Math.round(randomBetween(min, max) * 1000);
  }

  // ===== 主流程 =====

  async function processJobListPage() {
    log("===== 开始职位页拓客 =====");
    const jobListUrl = location.href;

    // 输出大模型配置状态，方便诊断
    if (config.llmEnabled) {
      if (config.llmApiKey) {
        log(`[LLM] 智能筛选已启用，模型=${config.llmModel || DEFAULT_CONFIG.llmModel}，阈值=${config.llmThreshold || DEFAULT_CONFIG.llmThreshold}`);
      } else {
        log('[LLM] 智能筛选开关已打开，但 API Key 为空，不会生效');
      }
    } else {
      log('[LLM] 智能筛选未启用');
    }

    // 从聊天页返回时，若当前页面没有目标岗位，重新点击推荐标签
    const returnSearchFlag = 'bossAutoReplyReturnSearch';
    if (sessionStorage.getItem(returnSearchFlag) === '1') {
      sessionStorage.removeItem(returnSearchFlag);
      log('[职位页] 从聊天页返回，检查目标岗位');
      if (!hasTargetCards()) {
        log('[职位页] 当前无目标岗位，尝试点击推荐标签');
        const tabLoaded = await clickTabAndWait();
        if (tabLoaded === 'navigated') {
          log('[导航] 页面正在跳转，由新页面自动恢复');
          return;
        }
        if (!tabLoaded) {
          log('[错误] 从聊天页返回后未点到目标标签，停止运行');
          sendStatus('未点到目标推荐标签', 'error');
          stopRun();
          return;
        }
      }
    }

    // 进入职位列表页后，若仍未看到目标岗位，尝试点击推荐标签
    if (!hasTargetCards()) {
      log('[职位页] 当前无目标岗位，尝试点击推荐标签');
      const tabLoaded = await clickTabAndWait();
      if (tabLoaded === 'navigated') {
        log('[导航] 页面正在跳转，由新页面自动恢复');
        return;
      }
      if (!tabLoaded) {
        log('[错误] 未点到目标推荐标签，停止运行');
        sendStatus('未点到目标推荐标签', 'error');
        stopRun();
        return;
      }
    }

    // 进入职位列表页后，确保官方薪资筛选已应用（首页直接 URL 跳转场景）
    log('[职位页] 准备应用官方薪资筛选');
    await applySalaryFilterOnce();

    let noCardWaitStart = Date.now();
    const NO_CARD_TIMEOUT = 60000; // 60秒整体超时
    let previousCardCount = 0;
    let noNewCardStreak = 0;
    const BOTTOM_REFRESH_STREAK = 2; // 连续2轮没有新卡片，视为滑到底部

    while (isRunning && !shouldStop) {
      // 页面被重置或变成 about:blank 时退出
      if (location.href === 'about:blank' || !location.href.includes('zhipin.com')) {
        log("[错误] 页面已被重置或跳转，停止运行");
        sendStatus("页面异常，请刷新后重试", "error");
        break;
      }

      if (isRiskDetected() || shouldStop) {
        log("[风控] 检测到操作频繁提示，自动停止");
        sendStatus("风控暂停：操作频繁", "error");
        break;
      }

      if (stats.success >= config.dailyLimit) {
        log(`[上限] 已达到每日上限 ${config.dailyLimit} 条，停止`);
        sendStatus(`已达到每日上限 ${config.dailyLimit} 条`, "idle");
        break;
      }

      if (!isInWorkHours()) {
        log("[时间] 非工作时间，暂停运行");
        sendStatus("非工作时间，已暂停", "idle");
        break;
      }

      const cards = getJobCards();
      if (cards.length === 0) {
        if (Date.now() - noCardWaitStart > NO_CARD_TIMEOUT) {
          log("[超时] 60秒内未检测到任何职位卡片，停止运行");
          sendStatus("未检测到职位卡片，请刷新页面或在 /web/geek/job 页面重试", "error");
          break;
        }
        log("[等待] 未找到职位卡片，等待页面渲染");
        await sleep(1000);
        continue;
      }

      // 找到卡片后重置等待计时器，并跟踪是否加载出新卡片
      noCardWaitStart = Date.now();
      if (cards.length === previousCardCount) {
        noNewCardStreak++;
      } else {
        noNewCardStreak = 0;
        previousCardCount = cards.length;
      }

      log(`[扫描] 找到 ${cards.length} 个职位卡片`);

      let processedInThisRound = 0;
      let cardIndex = 0;
      for (const card of cards) {
        if (!isRunning || shouldStop) break;

        // 每轮最多处理 15 个卡片，避免虚拟滚动列表中快速累加统计
        if (cardIndex >= 15) {
          log('[扫描] 本轮已处理 15 个卡片，先滚动加载更多');
          break;
        }
        cardIndex++;

        stats.total++;
        sendStats();

        const info = extractCardInfo(card);
        log(`[处理] ${info.title} | ${info.company} | ${info.city}`);

        if (!isTargetJob(info)) {
          stats.skipped++;
          sendStats();
          continue;
        }

        if (isDuplicate(info.jobId)) {
          log(`[去重] 已发送过，跳过: ${info.title}`);
          stats.skipped++;
          sendStats();
          continue;
        }

        // 如果启用大模型智能筛选，先展开详情提取描述并评分
        if (config.llmEnabled && config.llmApiKey) {
          log(`[LLM] 准备评分: ${info.title}`);
          await simulateClick(card);
          await sleep(randomBetween(1500, 2000));
          const description = extractJobDescription();
          if (description) {
            log(`[LLM] 提取到岗位描述 ${description.length} 字`);
          } else {
            log('[LLM] 未提取到岗位描述，仅用基本信息评分');
          }
          const result = await scoreJobWithLLM(info, description);
          if (result.score < 0) {
            // LLM 解析失败，回退到硬过滤（按薪资+城市+关键词）
            log(`[LLM] 解析失败，回退硬过滤: ${info.title}`);
            const [sMin, sMax] = parseSalary(info.salary);
            let cfgMin = Number(config.salaryMin) || 0;
            let cfgMax = Number(config.salaryMax) || 0;
            // 与其他硬过滤逻辑保持一致：上限超过 50K 按 50K 处理
            if (cfgMax > 50) cfgMax = 50;
            const salaryMismatch = (cfgMin > 0 && sMax > 0 && sMax < cfgMin) || (cfgMax > 0 && sMin > 0 && sMin > cfgMax);
            if (salaryMismatch) {
              log(`[LLM回退] 薪资 ${info.salary} 不在 ${cfgMin}-${cfgMax}K 范围，跳过`);
              stats.skipped++;
              sendStats();
              continue;
            }
          } else if (result.score < (Number(config.llmThreshold) || 70)) {
            log(`[LLM] 评分 ${result.score} 低于阈值 ${config.llmThreshold}，跳过: ${result.reason}`);
            stats.skipped++;
            sendStats();
            continue;
          } else {
            log(`[LLM] 评分 ${result.score}，通过筛选: ${result.reason}`);
          }
        }

        if (stats.success >= config.dailyLimit) break;

        // 两条消息之间按配置间隔等待（首次发送除外）
        if (stats.success > 0) {
          const interval = randomInterval();
          log(`[间隔] 已发送 ${stats.success} 条，等待 ${Math.round(interval / 1000)} 秒后继续`);
          await sleep(interval);
        }

        let chatBtn = findChatBtn(card);
        // 新版布局：沟通按钮在右侧详情面板，先点击卡片展开详情
        if (!chatBtn) {
          log(`[详情] 卡片内无沟通按钮，点击卡片展开详情: ${info.title}`);
          await simulateClick(card);
          await sleep(randomBetween(1200, 1800));
          chatBtn = findChatBtn(document);
          if (!chatBtn) {
            // 再等待一次，详情面板可能渲染较慢
            await sleep(1000);
            chatBtn = findChatBtn(document);
          }
        }
        if (!chatBtn) {
          log(`[跳过] 未找到沟通按钮: ${info.title}`);
          stats.skipped++;
          sendStats();
          continue;
        }

        // 保存状态，防止跳转后丢失
        saveState({
          isRunning: true,
          currentJobId: info.jobId,
          currentJobTitle: info.title,
          currentJobSalary: info.salary,
          jobListUrl,
          sentCount: stats.success,
          totalCount: stats.total,
          skippedCount: stats.skipped,
          failedCount: stats.failed,
        });

        log(`[点击] 立即沟通: ${info.title}`);
        const clicked = await withRetry(async () => {
          chatBtn.scrollIntoView({ behavior: 'instant', block: 'center' });
          await sleep(300);
          const ok = await simulateClick(chatBtn);
          if (!ok) {
            log('[点击] simulateClick 未成功，尝试直接 click()');
            chatBtn.click();
          }
          return true;
        }, 1, "点击沟通按钮");

        if (!clicked) {
          stats.failed++;
          sendStats();
          continue;
        }

        await sleep(randomBetween(2000, 3500));

        // 检测是否跳转到了聊天页
        if (isChatPage()) {
          log("[跳转] 已进入聊天页，由聊天页逻辑接管");
          return;
        }

        // 检测是否在当前页打开了聊天面板
        const chatInput = await waitForChatInput(4000);
        if (chatInput) {
          const sent = await sendGreeting(info.title, info.jobId);
          if (sent) {
            stats.success++;
            recordSent(info.jobId);
            sendStats();
            sendStatus(`已发送 ${stats.success}/${config.dailyLimit}`, "running");
          } else {
            stats.failed++;
            sendStats();
          }
          await closeChatPanel();
        } else {
          log(`[跳过] 聊天窗口未打开: ${info.title}`);
          stats.failed++;
          sendStats();
        }

        processedInThisRound++;
      }

      if (processedInThisRound === 0) {
        if (cards.length === 0) {
          log("[结束] 当前页面没有可处理的新目标");
          break;
        }
        if (noNewCardStreak >= BOTTOM_REFRESH_STREAK) {
          log('[刷新] 已滑到底部且无新卡片，刷新页面重新点击标签');
          sendStatus('已到底部，刷新重试...', 'running');
          saveState({
            isRunning: true,
            currentJobId: null,
            currentJobTitle: null,
            currentJobSalary: null,
            sentCount: stats.success,
            totalCount: stats.total,
            skippedCount: stats.skipped,
            failedCount: stats.failed,
          });
          try { sessionStorage.setItem('bossAutoReplyNeedTabClick', '1'); } catch (e) {}
          location.reload();
          return;
        }
        log("[滚动] 本轮卡片均不符合条件，滚动加载更多");
      }

      // 滚动加载更多
      log("[滚动] 加载更多职位");
      window.scrollBy(0, 800);
      await sleep(randomBetween(1500, 2500));
    }

    log("===== 职位页拓客结束 =====");
    stopRun();
  }

  async function processChatPage() {
    log("===== 进入聊天页，准备发送开场白 =====");
    const state = loadState();
    if (!state || !state.isRunning) {
      log("[聊天页] 无运行状态，不自动发送");
      return;
    }

    // 恢复统计
    stats.success = state.sentCount || 0;
    stats.total = state.totalCount || 0;
    stats.skipped = state.skippedCount || 0;
    stats.failed = state.failedCount || 0;
    isRunning = true;

    if (isRiskDetected()) {
      log("[风控] 检测到操作频繁提示，自动停止");
      sendStatus("风控暂停：操作频繁", "error");
      stopRun();
      return;
    }

    // 聊天页二次校验薪资：防止旧流程/恢复状态中的低价岗位发送
    // 如果启用了「薪资交给大模型判断」，则跳过这里的硬过滤，由 LLM 在职位页统一判断
    if (state.currentJobSalary && !(config.llmEnabled && config.llmApiKey && config.llmJudgeSalary)) {
      const [sMin, sMax] = parseSalary(state.currentJobSalary);
      let cfgMin = Number(config.salaryMin);
      let cfgMax = Number(config.salaryMax);
      if (cfgMax > 50) cfgMax = 50;
      if (sMin > 0 && sMax > 0) {
        if (cfgMin > 0 && sMax < cfgMin) {
          log(`[聊天页] 薪资过低，跳过发送: ${state.currentJobSalary}`);
          stats.skipped++;
          sendStats();
          saveState({
            ...state,
            currentJobId: null,
            currentJobTitle: null,
            currentJobSalary: null,
            skippedCount: stats.skipped,
          });
          await sleep(randomBetween(3000, 5000));
          try { sessionStorage.setItem('bossAutoReplyReturnSearch', '1'); } catch (e) {}
          await goBackToJobList(state.jobListUrl);
          return;
        }
        if (cfgMax > 0 && sMin > cfgMax) {
          log(`[聊天页] 薪资过高，跳过发送: ${state.currentJobSalary}`);
          stats.skipped++;
          sendStats();
          saveState({
            ...state,
            currentJobId: null,
            currentJobTitle: null,
            currentJobSalary: null,
            skippedCount: stats.skipped,
          });
          await sleep(randomBetween(3000, 5000));
          try { sessionStorage.setItem('bossAutoReplyReturnSearch', '1'); } catch (e) {}
          await goBackToJobList(state.jobListUrl);
          return;
        }
      }
    }

    const sent = await sendGreeting(state.currentJobTitle, state.currentJobId);
    if (sent) {
      stats.success++;
      recordSent(state.currentJobId);
      sendStats();
      sendStatus(`已发送 ${stats.success}/${config.dailyLimit}`, "running");
    } else {
      stats.failed++;
      sendStats();
    }

    // 更新状态：清除当前岗位信息，避免返回后重复进入聊天页
    saveState({
      ...state,
      currentJobId: null,
      currentJobTitle: null,
      sentCount: stats.success,
      totalCount: stats.total,
      skippedCount: stats.skipped,
      failedCount: stats.failed,
    });

    await sleep(randomBetween(3000, 5000));

    // 返回职位页继续，并标记需要重新搜索
    log("[返回] 返回职位页继续拓客");
    try { sessionStorage.setItem('bossAutoReplyReturnSearch', '1'); } catch (e) {}
    await goBackToJobList(state.jobListUrl);
  }

  // ===== 大模型智能筛选 =====

  // 从岗位详情面板提取职位描述
  function extractJobDescription() {
    const selectors = [
      '.job-detail-box .job-sec-text',
      '.job-detail .detail-content',
      '.job-detail-section .text',
      '[class*="job-detail"] [class*="description"]',
      '[class*="job-detail"] [class*="content"]',
      '.job-sec',
    ];
    for (const sel of selectors) {
      const el = document.querySelector(sel);
      if (el) {
        const text = (el.innerText || '').trim();
        if (text.length > 20) return text.slice(0, 3000);
      }
    }
    const detailPanel = document.querySelector('.job-detail-box, .job-detail, [class*="job-detail"], aside');
    if (detailPanel) {
      const text = (detailPanel.innerText || '').trim();
      if (text.length > 20) return text.slice(0, 3000);
    }
    return '';
  }

  // 通过 background service worker 代理跨域请求，避免内容脚本受页面 CSP/CORS 限制
  async function llmFetchViaBackground(url, options) {
    return new Promise((resolve, reject) => {
      chrome.runtime.sendMessage({ action: 'llmFetch', url, options }, (result) => {
        if (chrome.runtime.lastError) {
          reject(new Error(chrome.runtime.lastError.message || '后台请求失败'));
          return;
        }
        if (!result || !result.ok) {
          const errText = result?.text ? result.text.slice(0, 300) : (result?.error || `HTTP ${result?.status || '?'}`);
          reject(new Error(errText));
          return;
        }
        resolve(result.text);
      });
    });
  }

  // 调用大模型 API（兼容 OpenAI / Anthropic Messages 两种格式）
  // imageDataUrl 可选：传入选项卡/页面截图的 base64 data URL，用于视觉定位
  async function callLLM(prompt, imageDataUrl) {
    const apiKey = (config.llmApiKey || '').trim();
    let baseUrl = (config.llmBaseUrl || DEFAULT_CONFIG.llmBaseUrl).replace(/\/$/, '');
    const model = config.llmModel || DEFAULT_CONFIG.llmModel;
    if (!apiKey || !baseUrl || !model) {
      throw new Error('LLM 配置不完整');
    }

    // 决定 API 类型：auto 时根据 Key 前缀推断
    let apiType = (config.llmApiType || DEFAULT_CONFIG.llmApiType);
    if (apiType === 'auto') {
      apiType = apiKey.startsWith('sk-kimi-') ? 'anthropic' : 'openai';
    }

    // Anthropic 模式下如果用户没改 BaseURL，自动切换到 Kimi For Coding 默认端点
    if (apiType === 'anthropic' && baseUrl === DEFAULT_CONFIG.llmBaseUrl) {
      baseUrl = 'https://api.kimi.com/coding/v1';
    }

    // Anthropic 模式下如果用户没改模型名，给一个常见 Coding 模型默认值并提示
    let effectiveModel = model;
    if (apiType === 'anthropic' && model === DEFAULT_CONFIG.llmModel) {
      effectiveModel = 'claude-3-5-sonnet-20241022';
      log(`[LLM] Anthropic 模式自动切换模型为 ${effectiveModel}，如不可用请在面板修改`);
    }

    log(`[LLM] API类型: ${apiType}, 模型: ${effectiveModel}, BaseURL: ${baseUrl}, Key长度: ${apiKey.length}`);

    if (apiType === 'anthropic') {
      const url = `${baseUrl}/messages`;
      const userContent = [];
      if (imageDataUrl) {
        const [header, base64] = imageDataUrl.split(',');
        const mediaType = header ? header.replace(/^data:/, '').replace(/;base64$/, '') : 'image/png';
        userContent.push({ type: 'image', source: { type: 'base64', media_type: mediaType, data: base64 } });
      }
      userContent.push({ type: 'text', text: prompt });
      const body = {
        model: effectiveModel,
        max_tokens: 500,
        messages: [
          { role: 'user', content: userContent },
        ],
        system: '你是一位招聘筛选专家，请严格按用户要求输出JSON格式，不要输出任何其他内容。',
      };
      const text = await llmFetchViaBackground(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-api-key': apiKey,
          'anthropic-version': '2023-06-01',
        },
        body: JSON.stringify(body),
      });
      return extractTextFromLLMResponse(text, apiType);
    }

    // 默认 OpenAI 兼容格式
    const url = `${baseUrl}/chat/completions`;
    const userContent = [];
    if (imageDataUrl) {
      userContent.push({ type: 'image_url', image_url: { url: imageDataUrl } });
    }
    userContent.push({ type: 'text', text: prompt });
    const body = {
      model: effectiveModel,
      messages: [
        { role: 'system', content: '你是一位招聘筛选专家，请严格按用户要求输出JSON格式，不要输出任何其他内容。' },
        { role: 'user', content: userContent },
      ],
      temperature: 0.3,
      max_tokens: 500,
    };
    const text = await llmFetchViaBackground(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${apiKey}`,
      },
      body: JSON.stringify(body),
    });
    return extractTextFromLLMResponse(text, apiType);
  }

  // 从 LLM 原始响应文本中提取模型输出内容，兼容 OpenAI / Anthropic / 其他变体
  function extractTextFromLLMResponse(text, apiType) {
    if (!text || !text.trim()) {
      log('[LLM] 响应体为空');
      return '';
    }
    log(`[LLM] 原始响应(${apiType}): ${text.length < 800 ? text : text.slice(0, 800) + '...'}`);

    let data;
    try {
      data = JSON.parse(text);
    } catch (e) {
      log('[LLM] 响应不是合法 JSON，将直接按文本处理');
      return text;
    }

    // Anthropic Messages 格式（兼容 thinking / text 块）
    if (Array.isArray(data.content)) {
      const textBlocks = data.content
        .filter(b => b && (b.type === 'text' || b.text || b.type === 'thinking' || b.thinking))
        .map(b => b.text || b.thinking)
        .filter(Boolean);
      if (textBlocks.length) return textBlocks.join('\n');
    }

    // 可能的 Kimi / Anthropic 变体
    if (typeof data.output === 'string') return data.output;
    if (typeof data.response === 'string') return data.response;
    if (typeof data.result === 'string') return data.result;
    if (typeof data.text === 'string') return data.text;
    if (typeof data.content === 'string') return data.content;

    // OpenAI 兼容格式
    return data.choices?.[0]?.message?.content || data.choices?.[0]?.text || '';
  }

  // 使用大模型对岗位进行匹配评分
  // 返回 { score, reason }；若 LLM 解析失败，score 为 -1，由调用方回退到硬过滤
  async function scoreJobWithLLM(info, description) {
    const keywords = (config.jobKeywords || DEFAULT_CONFIG.jobKeywords).split(',').map(k => k.trim()).filter(Boolean).join('、');
    const targetCity = config.city || DEFAULT_CONFIG.city || '';
    const salaryMin = Number(config.salaryMin) || DEFAULT_CONFIG.salaryMin;
    const salaryMax = Number(config.salaryMax) || DEFAULT_CONFIG.salaryMax;

    const prompt = (config.llmPrompt || DEFAULT_CONFIG.llmPrompt)
      .replace(/\{title\}/g, info.title || '')
      .replace(/\{salary\}/g, info.salary || '')
      .replace(/\{city\}/g, info.city || '')
      .replace(/\{company\}/g, info.company || '')
      .replace(/\{description\}/g, description || '')
      .replace(/\{targetCity\}/g, targetCity)
      .replace(/\{salaryMin\}/g, salaryMin)
      .replace(/\{salaryMax\}/g, salaryMax)
      .replace(/\{keywords\}/g, keywords);

    try {
      const content = await callLLM(prompt);
      log(`[LLM] 原始返回: ${content.slice(0, 300)}...`);

      // 优先从 markdown 代码块中提取 JSON
      let jsonText = content;
      const codeBlockMatch = content.match(/```(?:json)?\s*([\s\S]*?)```/);
      if (codeBlockMatch && codeBlockMatch[1]) {
        jsonText = codeBlockMatch[1].trim();
      }

      const jsonMatch = jsonText.match(/\{[\s\S]*\}/);
      if (!jsonMatch) {
        throw new Error('返回中未找到JSON');
      }
      const result = JSON.parse(jsonMatch[0]);

      let score = Number(result.score);
      if (Number.isNaN(score)) {
        throw new Error(`score 不是数字: ${result.score}`);
      }
      score = Math.max(0, Math.min(100, score));

      log(`[LLM] 评分成功: score=${score}, reason=${result.reason || '无说明'}`);
      return { score, reason: result.reason || '无说明' };
    } catch (e) {
      log(`[LLM] 评分失败: ${e.message}，将回退到硬过滤`);
      return { score: -1, reason: `LLM解析失败: ${e.message}` };
    }
  }

  // 查找「薪资待遇」筛选按钮
  function findSalaryFilterBtn() {
    const all = document.querySelectorAll('button, div, span, li, a');
    for (const el of all) {
      const text = (el.textContent || '').trim();
      if (text === '薪资待遇' || text.includes('薪资待遇')) {
        if (isVisible(el) && (el.tagName === 'BUTTON' || el.getAttribute('role') === 'button' || el.children.length > 0)) {
          return el;
        }
      }
    }
    return null;
  }

  // 根据配置自动选择 Boss 直聘官方的"薪资待遇"筛选器
  async function applySalaryFilter() {
    let cfgMin = Number(config.salaryMin);
    let cfgMax = Number(config.salaryMax);
    if ((!cfgMin && !cfgMax) || cfgMin < 0 || cfgMax < 0) return false;

    // 兼容旧配置/宽泛配置：如果上限超过 50K，优先使用 20-50K 官方选项
    // 避免用户配置 20-100K 时错选成"50K以上"，导致低价岗位漏进来
    if (cfgMax > 50) {
      log(`[薪资筛选] 配置上限 ${cfgMax}K 超过 50K，按 20-50K 处理`);
      cfgMax = 50;
    }

    // 根据配置区间匹配 Boss 直聘预设选项
    // 注意：只有当最低薪资>=50K 时才选"50K以上"；配置 20-50K 时应选"20-50K"
    let targetText = "";
    if (cfgMin >= 50) targetText = "50K以上";
    else if (cfgMin >= 20 && cfgMax <= 50) targetText = "20-50K";
    else if (cfgMin >= 10 && cfgMax <= 20) targetText = "10-20K";
    else if (cfgMin >= 5 && cfgMax <= 10) targetText = "5-10K";
    else if (cfgMin >= 3 && cfgMax <= 5) targetText = "3-5K";
    else if (cfgMax <= 3) targetText = "3K以下";

    if (!targetText) {
      log(`[薪资筛选] 配置区间 ${cfgMin}-${cfgMax}K 无法匹配预设选项，跳过`);
      return false;
    }

    log(`[薪资筛选] 尝试选择: ${targetText}`);

    // 找到"薪资待遇"按钮
    const filterBtn = findSalaryFilterBtn();
    if (!filterBtn) {
      log('[薪资筛选] 未找到"薪资待遇"按钮');
      return false;
    }

    // 点击展开
    log('[薪资筛选] 点击薪资待遇按钮');
    await simulateClick(filterBtn);
    await sleep(randomBetween(1000, 1500));

    // 在下拉菜单中找目标选项，带重试
    let option = null;
    for (let attempt = 0; attempt < 5; attempt++) {
      const candidates = document.querySelectorAll('button, div, span, li, a, label');
      for (const el of candidates) {
        const text = (el.textContent || '').trim();
        if (text === targetText && isVisible(el)) {
          option = el;
          break;
        }
      }
      if (option) break;
      log(`[薪资筛选] 第 ${attempt + 1} 次未找到选项，等待下拉菜单渲染`);
      await sleep(400);
    }
    if (!option) {
      log(`[薪资筛选] 未找到选项: ${targetText}`);
      return false;
    }

    log(`[薪资筛选] 点击选项: ${targetText}`);
    await simulateClick(option);
    await sleep(randomBetween(1500, 2500));

    // 验证筛选是否生效：按钮文本应包含目标选项
    const currentFilterText = (filterBtn.textContent || '').trim();
    if (currentFilterText.includes(targetText)) {
      log(`[薪资筛选] 已生效: ${targetText}`);
      return true;
    }

    // 兜底：再次原生点击选项并关闭下拉菜单
    log('[薪资筛选] 选项点击可能未生效，执行兜底点击');
    option.click();
    await sleep(randomBetween(1000, 1500));

    const isDropdownOpen = Array.from(document.querySelectorAll('button, div, span, li, a, label')).some(el => {
      const text = (el.textContent || '').trim();
      return text === targetText && isVisible(el);
    });
    if (isDropdownOpen) {
      log('[薪资筛选] 下拉菜单未关闭，点击空白处关闭');
      document.body.dispatchEvent(new MouseEvent('click', { bubbles: true, clientX: 0, clientY: 0 }));
      await sleep(500);
    }

    log(`[薪资筛选] 完成: ${targetText}`);
    return true;
  }

  // 当前会话内只应用一次官方薪资筛选，避免 SPA 内重复点击
  async function applySalaryFilterOnce() {
    let cfgMin = Number(config.salaryMin);
    let cfgMax = Number(config.salaryMax);

    // 与 isTargetJob / applySalaryFilter 保持一致：上限超过 50K 按 50K 处理
    if (cfgMax > 50) {
      log(`[薪资筛选] 配置上限 ${cfgMax}K 超过 50K，按 50K 处理`);
      cfgMax = 50;
    }

    let targetText = "";
    if (cfgMin >= 50) targetText = "50K以上";
    else if (cfgMin >= 20 && cfgMax <= 50) targetText = "20-50K";
    else if (cfgMin >= 10 && cfgMax <= 20) targetText = "10-20K";
    else if (cfgMin >= 5 && cfgMax <= 10) targetText = "5-10K";
    else if (cfgMin >= 3 && cfgMax <= 5) targetText = "3-5K";
    else if (cfgMax <= 3) targetText = "3K以下";

    // 先检查当前筛选器状态，已符合目标则跳过
    const filterBtn = findSalaryFilterBtn();
    const currentText = filterBtn ? (filterBtn.textContent || '').trim() : '';
    if (targetText && currentText.includes(targetText)) {
      log(`[薪资筛选] 当前已是 ${targetText}，跳过`);
      salaryFilterAppliedInSession = true;
      return;
    }

    if (salaryFilterAppliedInSession) {
      log('[薪资筛选] 标记已设置但当前状态不符，重新应用');
    }

    const ok = await applySalaryFilter();
    if (ok) {
      salaryFilterAppliedInSession = true;
    }
  }

  // 检查当前页面是否存在目标岗位卡片
  function hasTargetCards() {
    const cards = getJobCards();
    for (const card of cards) {
      const info = extractCardInfo(card);
      if (isTargetJob(info)) return true;
    }
    return false;
  }

  // 查找 Boss 直聘顶部/筛选区的推荐标签（如"运营总监(杭州)"）
  // 优先使用 extractTopTabs() 返回的单个候选，避免选到包含多个标签的父容器
  function findRecommendedTab() {
    const keywords = (config.jobKeywords || DEFAULT_CONFIG.jobKeywords).split(/[,，]/).map(k => k.trim()).filter(Boolean);
    const city = (config.city || DEFAULT_CONFIG.city || '').trim();

    // 第1层：从 extractTopTabs() 的单个候选中匹配（最可靠）
    const topTabs = extractTopTabs();
    let considered = topTabs.map(t => `${t.text}(@${Math.round(t.el.getBoundingClientRect().top)})`);

    for (const t of topTabs) {
      const text = t.text;
      const hasKeyword = keywords.some(k => text.toLowerCase().includes(k.toLowerCase()));
      const hasCity = city && text.includes(city);
      if (hasKeyword && hasCity) return t.el;
    }
    for (const t of topTabs) {
      const text = t.text;
      const hasKeyword = keywords.some(k => text.toLowerCase().includes(k.toLowerCase()));
      if (hasKeyword) return t.el;
    }
    for (const t of topTabs) {
      const text = t.text;
      const hasCity = city && text.includes(city);
      if (hasCity && /运营.*(?:总监|经理|主管)|(?:总监|经理|主管).*运营/.test(text)) return t.el;
    }
    for (const t of topTabs) {
      const text = t.text;
      if (/运营(?:总监|经理|主管)/.test(text)) return t.el;
    }

    // 第2层：extractTopTabs 为空时，回退 DOM 扫描，但排除包含多个标签文本的容器
    if (topTabs.length === 0) {
      const candidates = document.querySelectorAll('a, div, span, li, button');
      let fallback = null;
      let mgmtFallback = null;
      let broadFallback = null;
      for (const el of candidates) {
        if (!isVisible(el)) continue;
        const rect = el.getBoundingClientRect();
        if (rect.top > 400) continue;
        const text = (el.innerText || el.textContent || '').trim();
        if (!text || text.length > 30 || text.includes('\n')) continue;
        considered.push(`${text}(@${Math.round(rect.top)})`);
        const hasKeyword = keywords.some(k => text.toLowerCase().includes(k.toLowerCase()));
        const hasCity = city && text.includes(city);
        if (hasKeyword && hasCity) return el;
        if (hasKeyword && !fallback) fallback = el;
        if (hasCity && !mgmtFallback && /运营.*(?:总监|经理|主管)|(?:总监|经理|主管).*运营/.test(text)) {
          mgmtFallback = el;
        }
        if (!broadFallback && /运营(?:总监|经理|主管)/.test(text)) {
          broadFallback = el;
        }
      }
      const result = fallback || mgmtFallback || broadFallback;
      if (!result) {
        log(`[标签] 未匹配到推荐标签，扫描了 ${considered.length} 个候选文本（前20）：${considered.slice(0, 20).join(' / ')}`);
      }
      return result;
    }

    log(`[标签] 未匹配到推荐标签，顶部候选（前20）：${considered.slice(0, 20).join(' / ')}`);
    return null;
  }

  // 提取页面顶部（可能是标签栏）的可点击文本项，交给 LLM 判断要点哪个
  function extractTopTabs() {
    const selectors = 'a, button, [role="tab"], li, div, span';
    const excluded = new Set(['首页', '职位', '公司', '校园·海归', 'APP', '有了', '海外', '项目外包', '推荐', '兼职', '求职类型', '薪资待遇', '工作经验', '学历要求', '公司行业', '公司规模', '北京', '上海', '广州', '深圳', '杭州', '成都', '武汉', '南京', '西安']);
    const map = new Map();
    document.querySelectorAll(selectors).forEach(el => {
      if (!isVisible(el)) return;
      const rect = el.getBoundingClientRect();
      if (rect.top > 400) return;
      const rawText = (el.innerText || el.textContent || '').trim();
      // 优先用 title/aria-label 获取完整文本，避免 CSS 截断
      const fullText = (el.getAttribute('title') || el.getAttribute('aria-label') || rawText).trim();
      if (!fullText || fullText.length > 30 || /^\d+$/.test(fullText)) return;
      if (fullText.length < 2) return;
      if (excluded.has(fullText)) return;
      // 跳过明显不是标签的噪音
      if (/^(搜索|筛选|排序|更多|收起|展开|确定|取消|重置|全部|城市)$/.test(fullText)) return;
      if (!map.has(fullText)) map.set(fullText, el);
    });
    return Array.from(map.entries()).map(([text, el]) => ({ text, el }));
  }

  // 使用 LLM 从顶部标签中选择最应点击的一个
  async function selectTabWithLLM(tabs) {
    if (!tabs || tabs.length === 0) return null;
    const apiKey = (config.llmApiKey || '').trim();
    if (!apiKey || !config.llmEnabled) return null;

    const keywords = (config.jobKeywords || DEFAULT_CONFIG.jobKeywords).split(/[,，]/).map(k => k.trim()).filter(Boolean).join('、');
    const city = config.city || DEFAULT_CONFIG.city || '';
    const tabList = tabs.map((t, i) => `${i + 1}. ${t.text}`).join('\n');

    const prompt = `你是招聘筛选助手。当前 Boss 直聘页面顶部有以下推荐标签/筛选项：\n${tabList}\n\n用户目标：在【${city}】找与以下关键词相关的岗位：${keywords}。优先选择管理层级（总监/经理/主管）或最贴近关键词的推荐标签。\n\n要求：\n1. 必须选择与目标城市【${city}】一致或岗位方向明显相关的标签；\n2. 不要选择"推荐"、"兼职"这类通用入口；\n3. 如果没有合适标签，请返回 {"tab": "", "reason": "无合适标签"}。\n\n请只输出 JSON：{"tab": "要点击的标签文本", "reason": "选择原因"}`;

    try {
      log(`[LLM标签] 发送候选列表给模型:\n${tabList}`);
      const content = await callLLM(prompt);
      const match = content.match(/\{[\s\S]*\}/);
      if (!match) {
        log('[LLM标签] 响应中未找到 JSON');
        return null;
      }
      const result = JSON.parse(match[0]);
      let chosen = result.tab || result.label || result.text;
      if (!chosen) return null;
      // 统一全角括号、空格、大小写，避免 "运营总监（杭州）" 与 "运营总监(杭州)" 无法匹配
      const norm = s => s.replace(/[（）【】\s]/g, m => ({ '（': '(', '）': ')', '【': '[', '】': ']', ' ': '', '　': '' }[m] || '')).toLowerCase();
      const nChosen = norm(chosen);
      const found = tabs.find(t => {
        const nt = norm(t.text);
        return nt.includes(nChosen) || nChosen.includes(nt);
      });
      if (found) {
        log(`[LLM标签] 选择标签: "${found.text}", 原因: ${result.reason || '无'}`);
      } else {
        log(`[LLM标签] LLM 返回的标签 "${chosen}" 未在候选中匹配，候选列表：${tabs.map(t => t.text).join(' / ')}`);
      }
      return found ? found.el : null;
    } catch (e) {
      log(`[LLM标签] 选择失败: ${e.message}`);
      return null;
    }
  }

  async function clickRecommendedTab() {
    let tab = findRecommendedTab();
    if (!tab && config.llmEnabled && config.llmApiKey) {
      const tabs = extractTopTabs();
      log(`[标签] 硬规则未命中，交给 LLM 从 ${tabs.length} 个顶部候选中选择`);
      tab = await selectTabWithLLM(tabs);
    }
    if (!tab) {
      log('[标签] 未找到匹配的推荐标签');
      return false;
    }
    const clickable = getClickableAncestor(tab);
    const text = (tab.innerText || tab.textContent || '').trim();
    const clickableTag = clickable.tagName && clickable.tagName.toLowerCase();
    log(`[标签] 点击推荐标签: "${text}" (实际触发元素: ${clickableTag}${clickable.className ? '.' + clickable.className.split(/\s+/).slice(0, 3).join('.') : ''})`);
    const clicked = await simulateClick(clickable);
    if (!clicked) {
      log('[标签] simulateClick 失败，尝试直接 click()');
      clickable.click();
    }
    await sleep(randomBetween(1500, 2500));
    return true;
  }

  // 从首页等非职位页，点击顶部导航的"职位"进入职位列表
  async function goToJobPage() {
    if (isJobListPage()) return true;

    log('[导航] 当前不在职位列表页，尝试点击顶部"职位"入口');
    const selectors = [
      'header a', 'header div', 'header span', 'header li',
      'nav a', 'nav div', 'nav span', 'nav li',
      '[class*="header"] a', '[class*="nav"] a',
    ];
    for (const sel of selectors) {
      const els = document.querySelectorAll(sel);
      for (const el of els) {
        if (!isVisible(el)) continue;
        const text = (el.innerText || el.textContent || '').trim();
        if (text !== '职位') continue;

        let target = el;
        if (el.tagName !== 'A' && el.tagName !== 'BUTTON' && el.getAttribute('role') !== 'button') {
          const clickable = el.closest('a, button, [role="button"]');
          if (clickable) target = clickable;
        }
        log('[导航] 点击顶部"职位"入口');
        const clicked = await simulateClick(target);
        if (!clicked) target.click();

        // 如果触发整页跳转，新页面加载后需要自动恢复并继续点标签
        saveState({ isRunning: true, startedAt: Date.now() });
        try { sessionStorage.setItem('bossAutoReplyNeedTabClick', '1'); } catch (e) {}

        // 等待页面完成跳转/渲染，最多 6 秒
        const navWaitStart = Date.now();
        while (Date.now() - navWaitStart < 6000) {
          await sleep(500);
          if (isJobListPage() && location.href.includes('/web/geek/job')) {
            log('[导航] 已进入职位列表页');
            return true;
          }
        }
        return isJobListPage();
      }
    }

    // DOM 方式找不到/点不到，使用 AI 视觉定位点击顶部"职位"
    if (config.llmEnabled && config.llmApiKey) {
      log('[导航] DOM 方式未找到"职位"入口，改用 AI 视觉定位');
      const visionOk = await clickTabWithVision('职位', '顶部导航栏');
      if (visionOk) {
        saveState({ isRunning: true, startedAt: Date.now() });
        try { sessionStorage.setItem('bossAutoReplyNeedTabClick', '1'); } catch (e) {}
        const navWaitStart = Date.now();
        while (Date.now() - navWaitStart < 6000) {
          await sleep(500);
          if (isJobListPage() && location.href.includes('/web/geek/job')) {
            log('[导航] 视觉点击后已进入职位列表页');
            return true;
          }
        }
        return isJobListPage();
      }
    }

    return false;
  }

  function getClickableAncestor(el, maxDepth = 4) {
    let node = el;
    for (let i = 0; i < maxDepth && node; i++) {
      const tag = node.tagName && node.tagName.toLowerCase();
      const role = node.getAttribute && node.getAttribute('role');
      if (tag === 'a' || tag === 'button' || role === 'tab' || role === 'button') return node;
      node = node.parentElement;
    }
    return el;
  }

  // 通过后台脚本截取当前标签页可见区域（需要 activeTab 权限）
  async function captureScreenshot() {
    return new Promise((resolve, reject) => {
      chrome.runtime.sendMessage({ action: 'captureVisibleTab' }, (result) => {
        if (chrome.runtime.lastError) {
          reject(new Error(chrome.runtime.lastError.message || '截图消息失败'));
          return;
        }
        if (!result || !result.ok) {
          reject(new Error(result?.error || '截图失败'));
          return;
        }
        resolve(result.dataUrl);
      });
    });
  }

  // 从可能包含多个标签文本的字符串中，挑出最符合目标城市/关键词/管理岗的单个标签
  function pickSingleTargetLabel(combinedText) {
    const city = config.city || DEFAULT_CONFIG.city || '';
    const keywords = (config.jobKeywords || DEFAULT_CONFIG.jobKeywords).split(/[,，]/).map(k => k.trim()).filter(Boolean);
    const parts = combinedText.split(/\s*[\n|丨]\s*/).map(s => s.trim()).filter(Boolean);
    if (parts.length <= 1) return combinedText;

    for (const p of parts) {
      const hasCity = city && p.includes(city);
      const hasKeyword = keywords.some(k => p.toLowerCase().includes(k.toLowerCase()));
      const hasMgmt = /运营.*(?:总监|经理|主管)|(?:总监|经理|主管).*运营/.test(p);
      if ((hasCity && hasMgmt) || (hasKeyword && hasCity) || hasMgmt) return p;
    }
    const cityMatch = parts.find(p => city && p.includes(city));
    return cityMatch || parts[0];
  }

  // 在指定视口坐标强行触发完整鼠标事件序列（mousedown -> mouseup -> click）
  // 不依赖元素自身的 click 事件监听，模拟真实用户点击
  function clickAtCoordinates(x, y) {
    const target = document.elementFromPoint(x, y);
    const bubbles = true;
    const cancelable = true;
    const view = window;
    const detail = 1;

    const mouseOpts = {
      bubbles,
      cancelable,
      view,
      detail,
      clientX: x,
      clientY: y,
      screenX: x + (window.screenX || 0),
      screenY: y + (window.screenY || 0),
      button: 0,
      buttons: 1,
      relatedTarget: null,
    };

    const mousedown = new MouseEvent('mousedown', mouseOpts);
    const mouseup = new MouseEvent('mouseup', mouseOpts);
    const click = new MouseEvent('click', mouseOpts);

    // 优先派发到坐标处的实际元素；若取不到元素则派发到 document
    const el = target || document.documentElement;
    el.dispatchEvent(mousedown);
    el.dispatchEvent(mouseup);
    el.dispatchEvent(click);

    // 再尝试对可点击祖先触发一次原生 click，确保 React/Vue 绑定生效
    try {
      const clickable = getClickableAncestor(el);
      if (clickable && clickable !== el) {
        clickable.click();
      }
    } catch (e) {
      // 忽略
    }

    return true;
  }

  // 截图传给 LLM，由 AI 返回指定文本元素的中心坐标，再在该坐标强行触发鼠标事件
  // expectedText: 要点击的文本，如 "职位" / "运营总监(杭州)"
  // contextHint: 可选，给 AI 的额外位置提示，如 "顶部导航栏" / "顶部推荐标签栏"
  async function clickTabWithVision(expectedText, contextHint) {
    const apiKey = (config.llmApiKey || '').trim();
    if (!apiKey) {
      log('[视觉] 未配置 LLM API Key，无法使用视觉定位');
      return false;
    }

    // 如果 expectedText 是多个标签拼接，先挑出单个目标标签
    const targetLabel = pickSingleTargetLabel(expectedText || `运营总监(${config.city || DEFAULT_CONFIG.city || '杭州'})`);
    const hint = contextHint || '页面顶部';
    log(`[视觉] 准备截图让 AI 定位: "${targetLabel}" (${hint})`);

    for (let attempt = 0; attempt <= 1; attempt++) {
      let dataUrl;
      try {
        dataUrl = await captureScreenshot();
      } catch (e) {
        log(`[视觉] 截图失败: ${e.message}`);
        return false;
      }

      const prompt = `你正在操作 Boss 直聘网页。当前截图中${hint}有可见元素/按钮/标签。请精确找到文本完全为 "${targetLabel}" 的单个可点击元素，返回该元素中心点在截图视口中的坐标（整数像素）。只输出 JSON：{"x": 整数, "y": 整数}。如果找不到或不确定，返回 {"found": false}。`;

      try {
        const resp = await callLLM(prompt, dataUrl);
        const match = resp.match(/\{[\s\S]*\}/);
        if (!match) {
          log('[视觉] LLM 未返回坐标 JSON');
          return false;
        }
        const result = JSON.parse(match[0]);
        if (result.found === false || typeof result.x !== 'number' || typeof result.y !== 'number') {
          log('[视觉] LLM 表示未找到目标元素');
          return false;
        }
        const { x, y } = result;
        if (x < 0 || y < 0 || x > window.innerWidth || y > window.innerHeight) {
          log(`[视觉] AI 返回坐标超出视口范围: (${x}, ${y})`);
          return false;
        }
        log(`[视觉] AI 返回坐标: (${x}, ${y})，准备强行点击`);

        clickAtCoordinates(x, y);
        await sleep(randomBetween(2000, 3000));
        return true;
      } catch (e) {
        log(`[视觉] 视觉点击失败: ${e.message}`);
        if (attempt === 0) {
          log('[视觉] 准备重试一次');
          await sleep(1500);
        } else {
          return false;
        }
      }
    }
    return false;
  }

  async function clickTabAndWait() {
    log('[启动] 等待并点击匹配的推荐标签');
    sendStatus('正在匹配推荐标签...', 'running');

    // 诊断 LLM 配置状态
    log(`[诊断] LLM启用=${!!config.llmEnabled}, APIKey存在=${!!(config.llmApiKey || '').trim()}, 版本=${PLUGIN_VERSION}`);

    // 等待顶部标签/筛选项渲染，最多 6 秒
    const tabWaitStart = Date.now();
    while (Date.now() - tabWaitStart < 6000) {
      if (extractTopTabs().length > 0) break;
      await sleep(500);
    }
    const tabs = extractTopTabs();
    log(`[诊断] extractTopTabs 返回 ${tabs.length} 个候选: ${tabs.slice(0, 10).map(t => t.text).join(' / ')}`);
    if (tabs.length === 0) {
      log('[标签] 未找到顶部任何候选标签');
      return false;
    }

    const keywords = (config.jobKeywords || DEFAULT_CONFIG.jobKeywords).split(/[,，]/).map(k => k.trim()).filter(Boolean);
    const city = config.city || DEFAULT_CONFIG.city || '';

    // 先找出最可能的目标标签文本，用于视觉定位
    let targetTextForVision = '';
    const targetByRules = tabs.find(t => {
      const hasCity = city && t.text.includes(city);
      const hasKeyword = keywords.some(k => t.text.toLowerCase().includes(k.toLowerCase()));
      const hasMgmt = /运营.*(?:总监|经理|主管)|(?:总监|经理|主管).*运营/.test(t.text);
      return (hasCity && hasMgmt) || (hasCity && hasKeyword) || hasMgmt;
    });
    if (targetByRules) {
      targetTextForVision = targetByRules.text;
      log(`[视觉] 已预选目标标签文本: "${targetTextForVision}"`);
    }

    // 方案 A：优先截图让 AI 视觉定位并强行点击
    if (config.llmEnabled && config.llmApiKey) {
      log('[视觉] 条件满足，准备调用视觉定位');
      const visionOk = await clickTabWithVision(targetTextForVision, '顶部推荐职位标签栏');
      if (visionOk) {
        const visionWaitStart = Date.now();
        while (Date.now() - visionWaitStart < 10000) {
          await sleep(500);
          if (getJobCards().length > 0 && hasTargetCards()) {
            log('[视觉] 已加载目标岗位结果');
            return true;
          }
        }
        log('[视觉] 点击后未立即加载到目标岗位，继续回退 DOM 方式');
      }
    } else {
      log(`[视觉] 跳过视觉定位: LLM启用=${!!config.llmEnabled}, APIKey存在=${!!(config.llmApiKey || '').trim()}`);
    }

    // 方案 B：视觉失败或未加载，回退到 DOM 选择
    // 优先让 LLM 判断该点哪个；LLM 未启用或失败时回退到硬规则
    let tab = null;
    if (config.llmEnabled && config.llmApiKey) {
      log(`[标签] 已启用 LLM，从 ${tabs.length} 个顶部候选中智能选择标签`);
      tab = await selectTabWithLLM(tabs);
      if (tab) {
        const chosenText = (tab.innerText || tab.textContent || '').trim();
        const hasCity = city && chosenText.includes(city);
        const hasKeyword = keywords.some(k => chosenText.toLowerCase().includes(k.toLowerCase()));
        const hasMgmt = /运营.*(?:总监|经理|主管)|(?:总监|经理|主管).*运营/.test(chosenText);
        if (!(hasCity || hasKeyword || hasMgmt)) {
          log(`[LLM标签] LLM 选中的 "${chosenText}" 不符合目标城市/关键词/管理岗，回退硬规则`);
          tab = null;
        }
      }
    }
    if (!tab) {
      tab = findRecommendedTab();
    }
    if (!tab) {
      const considered = tabs.map(t => `${t.text}(@${Math.round(t.el.getBoundingClientRect().top)})`).slice(0, 20).join(' / ');
      log(`[标签] 未匹配到推荐标签，候选文本：${considered}`);
      return false;
    }

    // 防止选中包含多个标签的父容器（innerText 含换行或过长）
    let selectedText = (tab.innerText || tab.textContent || '').trim();
    if (selectedText.includes('\n') || selectedText.length > 30) {
      log(`[标签] 初选元素包含多个标签文本（"${selectedText.slice(0, 60).replace(/\n/g, ' | ')}"），尝试从单个候选中重新定位`);
      const singleCandidate = tabs.find(t => {
        if (!selectedText.includes(t.text)) return false;
        const hasCity = city && t.text.includes(city);
        const hasKeyword = keywords.some(k => t.text.toLowerCase().includes(k.toLowerCase()));
        const hasMgmt = /运营.*(?:总监|经理|主管)|(?:总监|经理|主管).*运营/.test(t.text);
        return hasCity || hasKeyword || hasMgmt;
      });
      if (singleCandidate) {
        tab = singleCandidate.el;
        selectedText = singleCandidate.text;
        log(`[标签] 已重新定位到单个标签: "${selectedText}"`);
      }
    }

    // 有些标签文本在内部 span 上，实际点击事件在父级 a/button/li 上
    const clickable = getClickableAncestor(tab);
    const text = selectedText;
    const clickableTag = clickable.tagName && clickable.tagName.toLowerCase();
    const outerHTML = (clickable.outerHTML || '').replace(/>[\s\S]*$/, '>').slice(0, 300);
    const anchor = clickable.tagName.toLowerCase() === 'a' ? clickable : tab.closest('a');
    const href = anchor && anchor.href ? anchor.href : '';
    log(`[标签] 点击推荐标签: "${text}" (元素: ${clickableTag}${clickable.className ? '.' + clickable.className.split(/\s+/).slice(0, 3).join('.') : ''}, href: ${href || '无'}, outerHTML: ${outerHTML})`);

    // 如果标签带有 Boss 搜索链接，直接通过 href 导航兜底，绕过 SPA 事件触发不可靠的问题
    if (href && /query=/i.test(href) && /city=/i.test(href)) {
      log(`[标签] 使用 href 直接导航到目标页: ${href}`);
      saveState({ isRunning: true, sentCount: stats.success, totalCount: stats.total, skippedCount: stats.skipped, failedCount: stats.failed, startedAt: Date.now() });
      location.assign(href);
      return 'navigated';
    }

    // 兜底2：标签没有 href 时，从文本解析 "岗位名(城市)" 并构造搜索 URL
    const textMatch = text.match(/^(.+?)[\(（](.+?)[\)）]$/);
    if (textMatch) {
      const titlePart = textMatch[1].trim();
      const cityPart = textMatch[2].trim();
      const cityCode = CITY_CODE_MAP[cityPart];
      if (cityCode && titlePart) {
        const builtUrl = `https://www.zhipin.com/web/geek/jobs?query=${encodeURIComponent(titlePart)}&city=${cityCode}`;
        log(`[标签] 无 href，根据标签文本构造搜索 URL: ${builtUrl}`);
        saveState({ isRunning: true, sentCount: stats.success, totalCount: stats.total, skippedCount: stats.skipped, failedCount: stats.failed, startedAt: Date.now() });
        location.assign(builtUrl);
        return 'navigated';
      }
    }

    const clicked = await simulateClick(clickable);
    if (!clicked) {
      log('[标签] simulateClick 失败，尝试直接 click()');
    }
    // 模拟点击后再补一次原生 click，确保 SPA 标签真正切换
    clickable.click();
    await sleep(randomBetween(2000, 3000));

    // 点击标签后等待目标岗位卡片加载
    const waitStart = Date.now();
    const MAX_WAIT_MS = 10000;
    while (Date.now() - waitStart < MAX_WAIT_MS) {
      await sleep(500);
      const newCards = getJobCards();
      if (newCards.length > 0 && hasTargetCards()) {
        log('[标签] 已加载目标岗位结果');
        return true;
      }
    }
    // 输出当前卡片示例，便于诊断点了哪个标签
    const sampleCards = getJobCards().slice(0, 5).map(c => {
      try {
        const info = extractCardInfo(c);
        return `${info.title}(${info.city})`;
      } catch (e) { return '?'; }
    }).join(' / ');
    log(`[标签] 点击标签后未加载到目标岗位，当前卡片示例: ${sampleCards || '无卡片'}`);

    return false;

  }

  async function startRun() {
    if (isStarting) {
      log("[启动] 已有启动流程在进行中，忽略重复请求");
      return;
    }
    isStarting = true;
    log(`[启动] 开始拓客，当前页面: ${location.href}, 版本=${PLUGIN_VERSION}`);
    log(`[诊断-启动] LLM启用=${!!config.llmEnabled}, APIKey存在=${!!(config.llmApiKey || '').trim()}, 城市=${config.city || DEFAULT_CONFIG.city}`);
    isRunning = true;
    shouldStop = false;
    startRiskObserver();
    sendStatus("拓客中...", "running");

    if (isChatPage()) {
      log("[启动] 当前在聊天页，进入聊天流程");
      isStarting = false;
      processChatPage();
      return;
    }

    // 如果不是职位列表页，先点击顶部导航"职位"
    if (!isJobListPage()) {
      const entered = await goToJobPage();
      if (!entered) {
        log("[错误] 未能进入职位列表页，请手动点击顶部「职位」后重试");
        sendStatus("请手动点击顶部「职位」入口", "error");
        isStarting = false;
        stopRun();
        return;
      }
      // SPA 内跳转后已在职位页，清除整页跳转标记并继续
      try { sessionStorage.removeItem('bossAutoReplyNeedTabClick'); } catch (e) {}
    }

    // 轮询等待职位卡片渲染（SPA 页面卡片异步加载）
    const waitStart = Date.now();
    const MAX_WAIT_MS = 3000; // 首页通常没有职位卡片，3 秒后尝试点击推荐标签
    let cards = getJobCards();
    while (cards.length === 0 && Date.now() - waitStart < MAX_WAIT_MS) {
      sendStatus("等待页面加载...", "running");
      log("[等待] 等待职位卡片渲染...");
      await sleep(500);
      cards = getJobCards();
    }

    if (cards.length === 0) {
      const tabLoaded = await clickTabAndWait();
      if (tabLoaded === 'navigated') {
        log('[导航] 页面正在跳转，等待新页面自动恢复');
        isStarting = false;
        return;
      }

      // 点标签后再检查一次
      cards = getJobCards();
      if (cards.length === 0 || !tabLoaded) {
        log("[错误] 未找到推荐标签或未加载到职位卡片");
        sendStatus("未找到推荐标签，请确认页面有目标标签", "error");
        isStarting = false;
        stopRun();
        return;
      }
    }

    log(`[启动] 当前在职位页，检测到 ${cards.length} 个卡片`);

    // 如果当前页面没有目标岗位卡片，尝试点击推荐标签
    if (!hasTargetCards()) {
      const tabLoaded = await clickTabAndWait();
      if (tabLoaded === 'navigated') {
        log('[导航] 页面正在跳转，等待新页面自动恢复');
        isStarting = false;
        return;
      }
      if (!tabLoaded) {
        log("[错误] 未找到/未点到目标推荐标签，停止运行，避免处理默认职位列表");
        sendStatus("未点到目标推荐标签，请确认标签存在后重试", "error");
        isStarting = false;
        stopRun();
        return;
      }
    }

    isStarting = false;
    processJobListPage();
  }

  function stopRun() {
    isRunning = false;
    shouldStop = true;
    stopRiskObserver();
    clearState();
    sendStatus("已停止", "idle");
    try {
      chrome.runtime.sendMessage({ action: "stopped" });
    } catch (e) {}
  }

  function autoResume() {
    if (isRunning || isStarting) {
      log("[恢复] 已有运行状态，跳过自动恢复");
      return;
    }
    const state = loadState();
    if (state && state.isRunning) {
      log("[恢复] 检测到上次运行状态，自动恢复");
      isRunning = true;
      shouldStop = false;
      startRiskObserver();
      if (isChatPage()) {
        processChatPage();
      } else if (isJobListPage() || getJobCards().length > 0) {
        // 若上次是因为点击"职位"触发了整页跳转，恢复后继续点推荐标签
        const needTab = sessionStorage.getItem('bossAutoReplyNeedTabClick') === '1';
        if (needTab) {
          sessionStorage.removeItem('bossAutoReplyNeedTabClick');
          (async () => {
            const tabLoaded = await clickTabAndWait();
            if (tabLoaded === 'navigated') {
              log('[导航] 恢复流程中页面正在跳转，等待新页面自动恢复');
              return;
            }
            if (!tabLoaded) {
              log('[错误] 自动恢复后未点到目标推荐标签，停止运行');
              sendStatus('未点到目标推荐标签', 'error');
              stopRun();
              return;
            }
            processJobListPage();
          })();
        } else {
          processJobListPage();
        }
      } else {
        log("[恢复] 未找到职位页/聊天页上下文，停止恢复");
        clearState();
      }
    }
  }

  // ===== 消息监听 =====
  chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
    (async () => {
      if (msg.action === "start") {
        if (msg.config) config = { ...DEFAULT_CONFIG, ...msg.config };
        stats = { total: 0, success: 0, skipped: 0, failed: 0 };
        await startRun();
        sendResponse({ ok: true });
      }
      if (msg.action === "stop") {
        stopRun();
        sendResponse({ ok: true });
      }
      if (msg.action === "updateConfig") {
        if (msg.config) config = { ...DEFAULT_CONFIG, ...msg.config };
        sendResponse({ ok: true });
      }
      if (msg.action === "getLogs") {
        sendResponse({ logs: getLogs(msg.limit || 100) });
      }
      if (msg.action === "clearSent") {
        try {
          const map = getSentMap();
          const count = Object.keys(map).length;
          localStorage.removeItem(SENT_KEY);
          log(`[去重] 已清空 ${count} 条发送记录`);
          sendResponse({ success: true, count });
        } catch (e) {
          log(`[去重] 清空发送记录失败: ${e.message}`);
          sendResponse({ success: false, error: e.message });
        }
      }
    })();
    return true;
  });

  // 页面即将卸载时：从职位页/聊天页返回职位页需要保留状态以恢复；其他情况停止
  window.addEventListener('beforeunload', () => {
    if (!isRunning) return;
    const state = loadState() || {};
    const returnSearchFlag = sessionStorage.getItem('bossAutoReplyReturnSearch') === '1';
    if (isJobListPage() || returnSearchFlag) {
      log("[页面] 页面即将跳转，保存运行状态以便恢复");
      saveState({
        ...state,
        isRunning: true,
        sentCount: stats.success,
        totalCount: stats.total,
        skippedCount: stats.skipped,
        failedCount: stats.failed,
      });
    } else {
      log("[页面] 页面即将卸载，停止运行");
      stopRun();
    }
  });

  // 页面加载时自动加载配置、初始化日志并尝试恢复
  Promise.all([loadConfig(), initLogs(), cleanExpiredSent()]).then(() => {
    autoResume();
  });

})();
